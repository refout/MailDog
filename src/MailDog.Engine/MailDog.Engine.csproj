<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net11.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net11.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">$(DefineConstants);MAILDOG_WINDOWS</DefineConstants>
    <AssemblyName>MailDog.Engine</AssemblyName>
    <RootNamespace>MailDog.Engine</RootNamespace>
    <AssemblyTitle>MailDog</AssemblyTitle>
    <Product>MailDog</Product>
    <Description>MailDog 邮件客户端</Description>
    <Company>MailDog</Company>
    <ApplicationIcon>Assets/maildog.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2057;IL2060;IL2070;IL2072;IL2075;IL2090;IL2091;IL3050;IL3051;IL3053</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0-windows10.0.19041.0'">
    <Compile Remove="Tray/Win32Tray.cs" />
    <Compile Remove="Tray/ToastNotifier.cs" />
    <Compile Remove="Tray/ToastActivation.cs" />
    <Compile Remove="Tray/AvatarIconFactory.cs" />
    <Compile Remove="Tray/NativeMethods.cs" />
    <Compile Remove="Tray/AppIdentity.cs" />
    <Compile Remove="Tray/ShellIntegration.cs" />
    <Compile Remove="Hosting/StartupRegistration.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
    <Compile Remove="Tray/AppIdentity.Linux.cs" />
    <Compile Remove="Tray/ShellIntegration.Linux.cs" />
    <Compile Remove="Hosting/StartupRegistration.Linux.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MailDog.Contracts\MailDog.Contracts.csproj" />
    <ProjectReference Include="..\MailDog.Mail\MailDog.Mail.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 通知头部的小图标取自应用标识的 IconUri，需要能随时写出一个稳定的 ico 文件。 -->
    <EmbeddedResource Include="Assets\maildog.ico" LogicalName="maildog.ico" />
  </ItemGroup>
</Project>
