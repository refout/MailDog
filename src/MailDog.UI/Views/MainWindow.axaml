<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:MailDog.UI.ViewModels"
        x:Class="MailDog.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MailDog"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        TransparencyLevelHint="Mica, Blur"
        Background="Transparent">
  <Grid>
    <!-- 三栏内容 -->
    <Grid ColumnDefinitions="240,360,*" IsVisible="{Binding !IsOverlayOpen}">
      <!-- 文件夹栏 -->
      <Border Grid.Column="0"
              Background="{DynamicResource MailDogBrushBgSubtle}"
              BorderBrush="{DynamicResource MailDogBrushStroke}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8,12">
          <StackPanel Grid.Row="0">
            <Button Classes="account-add"
                    Command="{Binding OpenAddAccountCommand}"
                    IsVisible="{Binding !HasAccounts}"
                    AutomationProperties.Name="添加账户"
                    ToolTip.Tip="添加账户">
              <Grid ColumnDefinitions="Auto,*" MinHeight="48" Margin="8,4">
                <Border Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{DynamicResource MailDogBrushBgLayer}"
                        BorderBrush="{DynamicResource MailDogBrushStroke}"
                        BorderThickness="1">
                  <ic:FluentIcon Icon="Add"
                                 IconSize="Size16"
                                 Foreground="{DynamicResource MailDogBrushAccent}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                  <TextBlock Text="添加账户" FontSize="13" />
                  <TextBlock Text="添加你的第一个邮箱" Classes="caption" />
                </StackPanel>
              </Grid>
            </Button>

            <ListBox MaxHeight="200"
                     Background="Transparent"
                     Padding="0"
                     ItemsSource="{Binding Accounts}"
                     SelectedItem="{Binding SelectedAccount}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48" Margin="8,4">
                  <Border Grid.Column="0"
                          Width="28"
                          Height="28"
                          CornerRadius="14"
                          Background="{DynamicResource MailDogBrushAccent}">
                    <TextBlock Text="{Binding Initial}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              Margin="8,0"
                              VerticalAlignment="Center"
                              Spacing="1">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Email}"
                               Classes="caption"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SyncStatus}"
                               IsVisible="{Binding HasSyncStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource MailDogBrushAccent}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2"
                          Width="8"
                          Height="8"
                          CornerRadius="4"
                          Margin="4,0"
                          Background="{Binding StatusBrush}"
                          VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,12,8,8">
            <TextBlock Classes="section"
                       Text="文件夹"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="立即同步"
                    ToolTip.Tip="立即同步">
              <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" />
            </Button>
          </Grid>

          <ListBox Grid.Row="2"
                   Background="Transparent"
                   ItemsSource="{Binding Folders}"
                   SelectedItem="{Binding SelectedFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="36" Margin="4,0">
                  <ic:FluentIcon Grid.Column="0"
                                 Icon="Mail"
                                 IconSize="Size20"
                                 Margin="4,0"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsInbox}"
                                 Foreground="{DynamicResource MailDogBrushAccent}" />
                  <ic:FluentIcon Grid.Column="0"
                                 Icon="Folder"
                                 IconSize="Size20"
                                 Margin="4,0"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsNotInbox}"
                                 Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             FontSize="14"
                             Margin="8,0"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2"
                          MinWidth="20"
                          Height="16"
                          Padding="4,0"
                          CornerRadius="6"
                          Background="{DynamicResource MailDogBrushAccent}"
                          IsVisible="{Binding HasUnread}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding UnreadText}"
                               FontSize="11"
                               Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Grid.Row="3"
                  Command="{Binding OpenSettingsCommand}"
                  AutomationProperties.Name="设置"
                  ToolTip.Tip="设置"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Height="36"
                  Padding="12,0"
                  Margin="0,8,0,0"
                  Background="Transparent"
                  BorderThickness="0">
            <ic:FluentIcon Icon="Settings" IconSize="Size16" />
          </Button>
        </Grid>
      </Border>

      <!-- 邮件列表 -->
      <Border Grid.Column="1"
              Background="{DynamicResource MailDogBrushBgLayer}"
              BorderBrush="{DynamicResource MailDogBrushStroke}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,12,8">
            <TextBlock Text="{Binding FolderTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Width="96"
                      Height="28"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedIndex="{Binding FilterIndex}" />
          </Grid>

          <TextBox x:Name="SearchBox"
                   Grid.Row="1"
                   Height="32"
                   Margin="16,0,16,8"
                   Padding="10,0"
                   VerticalContentAlignment="Center"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="搜索邮件"
                   Text="{Binding SearchText}"
                   PlaceholderText="搜索邮件、发件人…" />

          <Border Grid.Row="2"
                  BorderBrush="{DynamicResource MailDogBrushStroke}"
                  BorderThickness="0,0,0,1"
                  Padding="16,0,12,8"
                  IsEnabled="{Binding !IsBatchBusy}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Content="全选"
                          FontSize="12"
                          IsChecked="{Binding IsAllChecked}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CheckedText}"
                           Classes="caption"
                           Margin="12,0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="清除"
                        FontSize="12"
                        Padding="8,2"
                        Command="{Binding ClearCheckedMessagesCommand}"
                        IsVisible="{Binding HasCheckedMessages}" />
              </Grid>
              <WrapPanel IsVisible="{Binding HasCheckedMessages}">
                <Button Content="标记已读"
                        FontSize="12"
                        Padding="10,4"
                        Margin="0,0,6,4"
                        Command="{Binding MarkCheckedReadCommand}" />
                <Button Content="标记未读"
                        FontSize="12"
                        Padding="10,4"
                        Margin="0,0,6,4"
                        Command="{Binding MarkCheckedUnreadCommand}" />
                <Button Content="添加旗标"
                        FontSize="12"
                        Padding="10,4"
                        Margin="0,0,6,4"
                        Command="{Binding FlagCheckedCommand}" />
                <Button Content="取消旗标"
                        FontSize="12"
                        Padding="10,4"
                        Margin="0,0,6,4"
                        Command="{Binding UnflagCheckedCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="3">
            <ListBox x:Name="MailList"
                     Classes="mail-list"
                     Background="Transparent"
                     ItemsSource="{Binding Messages}"
                     SelectedItem="{Binding SelectedMessage}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MailSummaryViewModel">
                  <Grid ColumnDefinitions="12,Auto,Auto,*" Height="76" Margin="12,0">
                    <Border Grid.Column="0"
                            Width="3"
                            Height="40"
                            CornerRadius="1.5"
                            Background="{DynamicResource MailDogBrushAccent}"
                            IsVisible="{Binding IsUnread}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              AutomationProperties.Name="选择邮件" />
                    <Border Grid.Column="2"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{Binding AvatarBrush}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding AvatarInitial}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Sender}"
                                   FontSize="14"
                                   FontWeight="{Binding SenderWeight}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TimeText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                      </Grid>
                      <TextBlock Text="{Binding Subject}"
                                 FontSize="14"
                                 FontWeight="{Binding SubjectWeight}"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Preview}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MailDogBrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                        <ic:FluentIcon Icon="Attach"
                                       IconSize="Size16"
                                       IsVisible="{Binding HasAttachments}"
                                       Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                        <ic:FluentIcon Icon="Flag"
                                       IconVariant="Filled"
                                       IconSize="Size16"
                                       IsVisible="{Binding IsFlagged}"
                                       Foreground="{DynamicResource MailDogBrushAccent}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border IsVisible="{Binding IsEmpty}"
                    Background="{DynamicResource MailDogBrushBgLayer}">
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="8">
                <ic:FluentIcon Icon="Mail"
                               IconSize="Size48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                <TextBlock Text="这个文件夹没有邮件"
                           FontSize="14"
                           HorizontalAlignment="Center" />
                <TextBlock Text="同步完成后会自动刷新"
                           Classes="caption"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <ProgressBar Grid.Row="4"
                       Height="2"
                       Margin="16,0"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsLoadingMore}" />
        </Grid>
      </Border>

      <!-- 阅读区 -->
      <Grid Grid.Column="2"
            RowDefinitions="Auto,Auto,*,Auto"
            Background="{DynamicResource MailDogBrushBgLayer}">
        <Border Grid.Row="0"
                Height="48"
                BorderBrush="{DynamicResource MailDogBrushStroke}"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal"
                      Spacing="4"
                      Margin="12,0"
                      VerticalAlignment="Center">
            <Button Command="{Binding ToggleReadCommand}" Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:FluentIcon Icon="Mail" IconSize="Size16" />
                <TextBlock Text="已读/未读" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ToggleFlagCommand}" Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:FluentIcon Icon="Flag" IconSize="Size16" />
                <TextBlock Text="旗标" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ShowImagesCommand}"
                    IsVisible="{Binding Reader.ImagesBlocked}"
                    Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:FluentIcon Icon="Image" IconSize="Size16" />
                <TextBlock Text="显示图片" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,16,24,0" Spacing="4">
          <TextBlock Text="{Binding Reader.Subject}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding Reader.SenderLine}"
                     FontSize="14"
                     Foreground="{DynamicResource MailDogBrushTextSecondary}" />
          <TextBlock Text="{Binding Reader.DateText}"
                     FontSize="12"
                     Foreground="{DynamicResource MailDogBrushTextTertiary}" />
          <ItemsControl ItemsSource="{Binding Reader.Attachments}"
                        IsVisible="{Binding Reader.HasAttachments}"
                        Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AttachmentViewModel">
                <Border Background="{DynamicResource MailDogBrushBgSubtle}"
                        BorderBrush="{DynamicResource MailDogBrushStroke}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Attach"
                                   IconSize="Size16"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FileName}"
                               FontSize="12"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SizeText}"
                               Classes="caption"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
          <ScrollViewer IsVisible="{Binding Reader.IsPlainText}">
            <SelectableTextBlock Text="{Binding Reader.PlainText}"
                                 Margin="24,8,24,24"
                                 FontSize="14"
                                 TextWrapping="Wrap" />
          </ScrollViewer>

          <NativeWebView x:Name="WebView" IsVisible="{Binding IsReaderHtmlVisible}" />

          <Border IsVisible="{Binding Reader.ShowEmpty}"
                  Background="{DynamicResource MailDogBrushBgLayer}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <ic:FluentIcon Icon="Mail"
                             IconSize="Size48"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource MailDogBrushTextTertiary}" />
              <TextBlock Text="选择一封邮件开始阅读"
                         FontSize="14"
                         HorizontalAlignment="Center" />
              <TextBlock Text="使用 ↑ ↓ 浏览，Enter 打开"
                         Classes="caption"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <ProgressBar IsIndeterminate="True"
                       Height="3"
                       VerticalAlignment="Top"
                       IsVisible="{Binding Reader.IsLoading}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="24,0,24,16" Spacing="8">
          <Border IsVisible="{Binding Reader.HasNotice}"
                  Background="{DynamicResource MailDogBrushWarningTint}"
                  CornerRadius="6"
                  Padding="12,8">
            <TextBlock Text="{Binding Reader.Notice}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Border>

          <Border IsVisible="{Binding Reader.HasError}"
                  Background="{DynamicResource MailDogBrushDangerTint}"
                  CornerRadius="6"
                  Padding="12,8">
            <TextBlock Text="{Binding Reader.Error}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MailDogBrushDanger}" />
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- 首次使用 -->
    <Border Grid.ColumnSpan="3"
            IsVisible="{Binding IsWelcomeVisible}"
            Background="{DynamicResource MailDogBrushBgBase}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <Border Width="72"
                Height="72"
                CornerRadius="14"
                ClipToBounds="True"
                HorizontalAlignment="Center">
          <Image Source="avares://MailDog.UI/Assets/logo.png"
                 Width="72"
                 Height="72"
                 Stretch="UniformToFill" />
        </Border>
        <TextBlock Text="添加你的第一个邮箱账户"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="支持 Outlook 浏览器登录与 QQ 邮箱授权码。"
                   Classes="caption"
                   HorizontalAlignment="Center" />
        <Button Content="添加账户"
                Command="{Binding OpenAddAccountCommand}"
                HorizontalAlignment="Center"
                Padding="16,8" />
      </StackPanel>
    </Border>

    <!-- 设置页：主窗口内整页显示 -->
    <Border Grid.ColumnSpan="3"
            IsVisible="{Binding IsSettingsOpen}"
            Background="{DynamicResource MailDogBrushBgBase}">
      <Grid RowDefinitions="56,*">
        <Border BorderBrush="{DynamicResource MailDogBrushStroke}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*" Margin="16,0">
            <Button Classes="icon"
                    Command="{Binding BackFromOverlayCommand}"
                    AutomationProperties.Name="返回"
                    ToolTip.Tip="返回">
              <ic:FluentIcon Icon="ChevronLeft" IconSize="Size20" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding OverlayTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="8,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <!-- 设置 -->
          <Grid IsVisible="{Binding IsSettingsOpen}"
                ColumnDefinitions="220,*">
            <Border Background="{DynamicResource MailDogBrushBgSubtle}"
                    BorderBrush="{DynamicResource MailDogBrushStroke}"
                    BorderThickness="0,0,1,0">
                  <Grid RowDefinitions="*,Auto">
                    <ListBox SelectedIndex="{Binding SettingsSectionIndex}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8">
                      <ListBoxItem Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:FluentIcon Icon="Settings" IconSize="Size16" />
                          <TextBlock Text="外观" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                      </ListBoxItem>
                      <ListBoxItem Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:FluentIcon Icon="Alert" IconSize="Size16" />
                          <TextBlock Text="通知" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                      </ListBoxItem>
                      <ListBoxItem Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:FluentIcon Icon="DocumentText" IconSize="Size16" />
                          <TextBlock Text="阅读" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                      </ListBoxItem>
                      <ListBoxItem Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" />
                          <TextBlock Text="同步" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                      </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource MailDogBrushStroke}"
                            BorderThickness="0,1,0,0"
                            Padding="8">
                      <StackPanel Spacing="2">
                        <Button Command="{Binding OpenAddAccountCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8"
                                Background="Transparent">
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <ic:FluentIcon Icon="Add" IconSize="Size16" />
                            <TextBlock Text="添加账户" FontSize="13" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAboutCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8"
                                Background="Transparent">
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <ic:FluentIcon Icon="Info" IconSize="Size16" />
                            <TextBlock Text="关于" FontSize="13" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="*,Auto">
                  <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="32,24,32,16" Spacing="24">
                      <StackPanel IsVisible="{Binding IsAppearanceSection}" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold" />
                          <TextBlock Text="主题、窗口材质与背景" Classes="caption" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                          <TextBlock Text="主题" FontSize="13" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="theme"
                                         Content="跟随系统"
                                         IsChecked="{Binding IsThemeSystem}" />
                            <RadioButton GroupName="theme"
                                         Content="浅色"
                                         IsChecked="{Binding IsThemeLight}" />
                            <RadioButton GroupName="theme"
                                         Content="深色"
                                         IsChecked="{Binding IsThemeDark}" />
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                          <TextBlock Text="背景材质" FontSize="13" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="material"
                                         Content="无"
                                         IsChecked="{Binding IsMaterialNone}" />
                            <RadioButton GroupName="material"
                                         Content="云母"
                                         IsChecked="{Binding IsMaterialMica}" />
                            <RadioButton GroupName="material"
                                         Content="亚克力"
                                         IsChecked="{Binding IsMaterialAcrylic}" />
                          </StackPanel>
                          <TextBlock Text="云母仅 Windows 11 支持；不可用时自动回退为纯色。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                          <TextBlock Text="背景颜色" FontSize="13" />
                          <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding BackgroundPresets}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackgroundPresetViewModel">
                                  <Button Width="36"
                                          Height="36"
                                          Margin="0,0,8,8"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          AutomationProperties.Name="{Binding Name}"
                                          Command="{Binding SelectCommand}"
                                          ToolTip.Tip="{Binding Name}">
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="7"
                                            Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource MailDogBrushStroke}"
                                            BorderThickness="1" />
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Width="36"
                                    Height="36"
                                    Margin="0,0,8,8"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AutomationProperties.Name="自定义颜色"
                                    ToolTip.Tip="自定义颜色">
                              <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                  <ColorView Color="{Binding BackgroundColorValue, Mode=TwoWay}"
                                             IsAlphaEnabled="False"
                                             IsHexInputVisible="False"
                                             IsColorComponentsVisible="False"
                                             IsAccentColorsVisible="False"
                                             Width="320" />
                                </Flyout>
                              </Button.Flyout>
                              <Border Width="30"
                                      Height="30"
                                      CornerRadius="7"
                                      BorderBrush="{DynamicResource MailDogBrushStroke}"
                                      BorderThickness="1">
                                <Border.Background>
                                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#F25022" />
                                    <GradientStop Offset="0.25" Color="#FFB900" />
                                    <GradientStop Offset="0.5" Color="#7FBA00" />
                                    <GradientStop Offset="0.75" Color="#00A4EF" />
                                    <GradientStop Offset="1" Color="#B4009E" />
                                  </LinearGradientBrush>
                                </Border.Background>
                                <ic:FluentIcon Icon="PaintBrush"
                                               IconSize="Size16"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                              </Border>
                            </Button>
                          </StackPanel>
                          <TextBlock Text="直接点击颜色块即可应用，最后一个色块可自定义任意颜色。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="背景不透明度" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding OpacityText}" Classes="caption" />
                          </Grid>
                          <Slider Minimum="40"
                                  Maximum="100"
                                  Value="{Binding BackgroundOpacityValue}"
                                  AutomationProperties.Name="背景不透明度" />
                          <TextBlock Text="低于 100% 时窗口背景透出桌面；启用材质时控制材质强度。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsNotificationsSection}" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Text="通知" FontSize="20" FontWeight="SemiBold" />
                          <TextBlock Text="新邮件到达时显示系统通知。" Classes="caption" />
                        </StackPanel>
                        <CheckBox Content="新邮件通知" IsChecked="{Binding NotificationsEnabled}" />
                        <CheckBox Content="通知声音" IsChecked="{Binding NotificationSoundEnabled}" />
                        <StackPanel Spacing="6" IsEnabled="{Binding NotificationSoundEnabled}">
                          <Grid ColumnDefinitions="Auto,Auto,*">
                            <TextBlock Text="通知铃声" FontSize="13" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="试听"
                                    Command="{Binding PreviewNotificationSoundCommand}"
                                    Padding="10,2"
                                    Margin="12,0,0,0"
                                    FontSize="12" />
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="sound"
                                         Content="默认"
                                         IsChecked="{Binding IsSoundDefault}" />
                            <RadioButton GroupName="sound"
                                         Content="邮件"
                                         IsChecked="{Binding IsSoundMail}" />
                            <RadioButton GroupName="sound"
                                         Content="提醒"
                                         IsChecked="{Binding IsSoundReminder}" />
                            <RadioButton GroupName="sound"
                                         Content="提示"
                                         IsChecked="{Binding IsSoundAsterisk}" />
                          </StackPanel>
                          <TextBlock Text="选择新邮件通知使用的系统提示音。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsReadingSection}" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Text="阅读" FontSize="20" FontWeight="SemiBold" />
                          <TextBlock Text="打开邮件时的默认行为。" Classes="caption" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                          <TextBlock Text="渲染方式" FontSize="13" />
                          <CheckBox Content="全量渲染（HTML）" IsChecked="{Binding IsHtmlRenderMode}" />
                          <CheckBox Content="纯文本" IsChecked="{Binding IsPlainRenderMode}" />
                          <TextBlock Text="纯文本模式只显示文本内容；邮件没有纯文本段时会从 HTML 提取文本。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Content="打开邮件时标记为已读" IsChecked="{Binding MarkReadOnOpen}" />
                        <CheckBox Content="默认显示远程图片" IsChecked="{Binding ShowRemoteImages}" />
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsSyncSection}" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Text="同步" FontSize="20" FontWeight="SemiBold" />
                          <TextBlock Text="控制后台检查新邮件的频率。" Classes="caption" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                          <TextBlock Text="同步间隔" FontSize="13" />
                          <WrapPanel>
                            <RadioButton GroupName="sync"
                                         Content="1 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync1Minute}" />
                            <RadioButton GroupName="sync"
                                         Content="5 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync5Minutes}" />
                            <RadioButton GroupName="sync"
                                         Content="15 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync15Minutes}" />
                            <RadioButton GroupName="sync"
                                         Content="30 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync30Minutes}" />
                            <RadioButton GroupName="sync"
                                         Content="60 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync60Minutes}" />
                          </WrapPanel>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>

                  <Border Grid.Row="1"
                          BorderBrush="{DynamicResource MailDogBrushStroke}"
                          BorderThickness="0,1,0,0"
                          Padding="32,10">
                    <TextBlock Text="{Binding SettingsSaveHint}"
                               Classes="caption"
                               VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Grid>

        </Grid>
      </Grid>
    </Border>

    <!-- 添加账户：当前窗口内的模态卡片 -->
    <Border Grid.ColumnSpan="3"
            IsVisible="{Binding IsAddAccountOpen}"
            Background="#66000000">
      <Border Width="520"
              MaxHeight="600"
              Margin="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource MailDogBrushBgLayer}"
              BorderBrush="{DynamicResource MailDogBrushStroke}"
              BorderThickness="1"
              CornerRadius="{DynamicResource OverlayCornerRadius}"
              Padding="24"
              BoxShadow="0 12 32 0 #48000000">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Text="添加账户"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding BackFromOverlayCommand}"
                    AutomationProperties.Name="关闭"
                    ToolTip.Tip="关闭">
              <ic:FluentIcon Icon="Dismiss" IconSize="Size16" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
              <ComboBox ItemsSource="{Binding ProviderOptions}"
                        SelectedIndex="{Binding SelectedProviderIndex}"
                        HorizontalAlignment="Stretch" />

              <TextBox Text="{Binding AddAccountEmail}"
                       PlaceholderText="邮箱地址" />

              <TextBox Text="{Binding AddAccountSecret}"
                       PlaceholderText="QQ 邮箱授权码"
                       PasswordChar="●"
                       IsVisible="{Binding IsQqProvider}" />

              <TextBlock Text="授权码不是 QQ 密码。请先在 QQ 邮箱设置中开启 IMAP/SMTP 并生成授权码。"
                         Classes="caption"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsQqProvider}" />

              <Button Content="连接"
                      Command="{Binding AddPasswordAccountCommand}"
                      IsVisible="{Binding IsQqProvider}"
                      HorizontalAlignment="Stretch"
                      Padding="12,8" />

              <Button Content="使用浏览器登录"
                      Command="{Binding StartOAuthCommand}"
                      IsVisible="{Binding IsOutlookProvider}"
                      HorizontalAlignment="Stretch"
                      Padding="12,8" />

              <ProgressBar IsIndeterminate="True"
                           Height="3"
                           IsVisible="{Binding IsAddingAccount}" />

              <TextBlock Text="{Binding AddAccountStatus}"
                         Classes="caption"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- 关于：当前窗口内的模态卡片 -->
    <Border Grid.ColumnSpan="3"
            IsVisible="{Binding IsAboutOpen}"
            Background="#66000000">
      <Border Width="560"
              MaxHeight="640"
              Margin="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource MailDogBrushBgLayer}"
              BorderBrush="{DynamicResource MailDogBrushStroke}"
              BorderThickness="1"
              CornerRadius="{DynamicResource OverlayCornerRadius}"
              Padding="24"
              BoxShadow="0 12 32 0 #48000000">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Text="关于"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding BackFromOverlayCommand}"
                    AutomationProperties.Name="关闭"
                    ToolTip.Tip="关闭">
              <ic:FluentIcon Icon="Dismiss" IconSize="Size16" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="48"
                        Height="48"
                        CornerRadius="10"
                        ClipToBounds="True">
                  <Image Source="avares://MailDog.UI/Assets/logo.png"
                         Width="48"
                         Height="48"
                         Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="MailDog" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding VersionText}" Classes="caption" />
                </StackPanel>
              </StackPanel>

              <TextBlock Text="双进程、全 Native AOT 的桌面邮件客户端。"
                         TextWrapping="Wrap" />

              <Border Background="{DynamicResource MailDogBrushBgSubtle}"
                      BorderBrush="{DynamicResource MailDogBrushStroke}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="运行时" Classes="section" />
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text=".NET" FontSize="13" Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding RuntimeText}" FontSize="13" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="界面" FontSize="13" Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="Avalonia 12.1.6 · Fluent" FontSize="13" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="邮件" FontSize="13" Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="MailKit 5.0.0" FontSize="13" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="存储" FontSize="13" Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="SQLite" FontSize="13" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </Border>

              <Button Content="打开项目主页"
                      Command="{Binding OpenProjectPageCommand}"
                      HorizontalAlignment="Stretch"
                      Padding="16,8" />

              <TextBlock Text="界面图标来自 Fluent UI System Icons（MIT）。"
                         Classes="caption"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
