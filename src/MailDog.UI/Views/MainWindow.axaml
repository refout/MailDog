<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:controls="using:MailDog.UI.Controls"
        xmlns:vm="using:MailDog.UI.ViewModels"
        xmlns:views="using:MailDog.UI.Views"
        x:Class="MailDog.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MailDog"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="680"
        TransparencyLevelHint="Mica, Blur"
        Background="Transparent">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            IsVisible="{Binding IsOffline}"
            Background="{DynamicResource MailDogBrushStatusWarningTint}"
            BorderBrush="{DynamicResource MailDogBrushStatusWarning}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <ic:FluentIcon Grid.Column="0"
                       Icon="Warning"
                       IconSize="Size16"
                       Foreground="{DynamicResource MailDogBrushStatusWarning}"
                       VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Text="{Binding OfflineTitle}"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding OfflineMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource MailDogBrushTextSecondary}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2"
                Content="{Binding OfflineActionText}"
                Command="{Binding RetryOfflineCommand}"
                IsEnabled="{Binding !IsBusy}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 三栏内容：文件夹栏、邮件列表、阅读区；设置页独立占满内容区 -->
    <Grid x:Name="MailColumns" Grid.Row="1" ColumnDefinitions="240,360,*" IsVisible="{Binding !IsSettingsOpen}">
      <!-- 文件夹栏 -->
      <Border Grid.Column="0"
              Background="{DynamicResource MailDogBrushSurfaceSubtle}"
              BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="16">
          <StackPanel Grid.Row="0">
            <Button Command="{Binding NewMailCommand}"
                    Classes="primary"
                    IsEnabled="{Binding HasAccounts}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10"
                    ToolTip.Tip="写邮件"
                    AutomationProperties.Name="写邮件">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Edit" IconSize="Size16" />
                <TextBlock Text="写邮件" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="account-add"
                    Command="{Binding OpenAddAccountCommand}"
                    IsVisible="{Binding !HasAccounts}"
                    AutomationProperties.Name="添加账户"
                    ToolTip.Tip="添加账户">
              <Grid ColumnDefinitions="Auto,*" MinHeight="48" Margin="8,4">
                <Border Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{DynamicResource MailDogBrushSurfacePane}"
                        BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                        BorderThickness="1">
                  <ic:FluentIcon Icon="Add"
                                 IconSize="Size16"
                                 Foreground="{DynamicResource MailDogBrushAccentBase}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                  <TextBlock Text="添加账户" FontSize="13" />
                  <TextBlock Text="添加你的第一个邮箱" Classes="caption" />
                </StackPanel>
              </Grid>
            </Button>

            <!-- 聚合收件箱：其余文件夹统一放在账户树下，避免两套重复目录。 -->
            <ItemsControl ItemsSource="{Binding UnifiedFolders}" Margin="0,2,0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UnifiedFolderViewModel">
                  <Button Classes="nav-item"
                          Classes.active="{Binding IsActive}"
                          AutomationProperties.Name="{Binding Name}"
                          Click="OnUnifiedFolderClick">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <ic:FluentIcon Grid.Column="0"
                                     Icon="{Binding IconKind}"
                                     IconSize="Size16"
                                     Foreground="{DynamicResource MailDogBrushTextSecondary}"
                                     VerticalAlignment="Center"
                                     Margin="2,0,8,0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Name}"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="2"
                              MinWidth="20"
                              Height="16"
                              Padding="4,0"
                              CornerRadius="8"
                              Background="{DynamicResource MailDogBrushAccentBase}"
                              IsVisible="{Binding HasUnread}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnreadText}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" Margin="10,12,2,4">
              <TextBlock Classes="section"
                         Text="账户"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="icon"
                      Command="{Binding RefreshCommand}"
                      AutomationProperties.Name="立即同步"
                      ToolTip.Tip="立即同步">
                <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" />
              </Button>
            </Grid>
          </StackPanel>

          <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <TreeView x:Name="FolderTree"
                    Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding Accounts}"
                    SelectedItem="{Binding SelectedSidebarItem}">
            <TreeView.ItemContainerTheme>
              <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="CornerRadius" Value="6" />
              </ControlTheme>
            </TreeView.ItemContainerTheme>
            <TreeView.DataTemplates>
              <!-- 一级：账户 -->
              <TreeDataTemplate DataType="{x:Type vm:AccountViewModel}"
                                x:DataType="vm:AccountViewModel"
                                ItemsSource="{Binding Folders}">
                <Grid ColumnDefinitions="26,*,Auto"
                      MinHeight="44"
                      Margin="0,2"
                      ToolTip.Tip="{Binding Email}">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="新建文件夹"
                                Click="OnCreateFolderClick">
                        <MenuItem.Icon>
                          <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Border Grid.Column="0"
                          Width="26"
                          Height="26"
                          CornerRadius="13"
                          Background="{DynamicResource MailDogBrushAccentBase}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              Margin="10,0,6,0"
                              VerticalAlignment="Center"
                              Spacing="1">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Email}"
                               FontSize="11"
                               Foreground="{DynamicResource MailDogBrushTextTertiary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SyncStatus}"
                               IsVisible="{Binding HasSyncStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource MailDogBrushAccentBase}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2"
                          Width="8"
                          Height="8"
                          CornerRadius="4"
                          Margin="4,0"
                          Background="{Binding StatusBrush}"
                          VerticalAlignment="Center" />
                </Grid>
              </TreeDataTemplate>

              <!-- 二级：账户下的文件夹 -->
              <DataTemplate DataType="{x:Type vm:FolderViewModel}" x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="30">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="重命名"
                                IsVisible="{Binding IsCustomFolder}"
                                Click="OnRenameFolderClick">
                        <MenuItem.Icon>
                          <ic:FluentIcon Icon="Edit" IconSize="Size16" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="删除文件夹"
                                IsVisible="{Binding IsCustomFolder}"
                                Click="OnDeleteFolderClick">
                        <MenuItem.Icon>
                          <ic:FluentIcon Icon="Delete" IconSize="Size16" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <ic:FluentIcon Grid.Column="0"
                                 Icon="{Binding IconKind}"
                                 IconSize="Size16"
                                 Foreground="{DynamicResource MailDogBrushTextSecondary}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             FontSize="13"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2"
                          MinWidth="20"
                          Height="16"
                          Padding="4,0"
                          CornerRadius="8"
                          Background="{DynamicResource MailDogBrushAccentBase}"
                          IsVisible="{Binding HasUnread}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding UnreadText}"
                               FontSize="10.5"
                               Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>

            <Border Grid.Row="1"
                    Margin="4,8,4,0"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource MailDogBrushSurfacePane}"
                    BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                    BorderThickness="1"
                    IsVisible="{Binding IsFolderEditorOpen}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding FolderEditorTitle}"
                           FontSize="12.5"
                           FontWeight="SemiBold" />
                <TextBox Classes="single-line"
                         Text="{Binding FolderEditorName, Mode=TwoWay}"
                         PlaceholderText="文件夹名称" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                  <Button Content="取消"
                          Command="{Binding CancelFolderEditCommand}" />
                  <Button Content="保存"
                          Classes="primary"
                          Command="{Binding SubmitFolderEditCommand}"
                          IsEnabled="{Binding CanSubmitFolderEdit}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="4,8,4,0"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource MailDogBrushStatusWarningTint}"
                    BorderBrush="{DynamicResource MailDogBrushStatusWarning}"
                    BorderThickness="1"
                    IsVisible="{Binding IsFolderDeleteConfirmOpen}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding FolderDeletePrompt}"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                  <Button Content="取消"
                          Command="{Binding CancelFolderDeleteCommand}" />
                  <Button Content="删除"
                          Classes="danger"
                          Command="{Binding ConfirmDeleteFolderCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Grid.Row="2" Spacing="2" Margin="0,8,0,0">
            <Button Classes="nav-item"
                    Command="{Binding OpenSettingsCommand}"
                    AutomationProperties.Name="设置"
                    ToolTip.Tip="设置">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Settings" IconSize="Size16" />
                <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 邮件列表 -->
      <Border Grid.Column="1"
              Background="{DynamicResource MailDogBrushSurfaceContent}"
              BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,16">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,16,8">
            <TextBlock Classes="page-title" Text="{Binding FolderTitle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
              <Button x:Name="JumpButton"
                      Classes="icon"
                      AutomationProperties.Name="跳转"
                      ToolTip.Tip="{Binding JumpLabel}">
                <ic:FluentIcon Icon="Calendar" IconSize="Size16" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight" Closed="OnJumpFlyoutClosed">
                    <StackPanel MinWidth="180" Spacing="2">
                      <Button Classes="jump-item"
                              Classes.active="{Binding IsJumpToday}"
                              Tag="1"
                              Content="今天"
                              Click="OnJumpRangeItemClick" />
                      <Button Classes="jump-item"
                              Classes.active="{Binding IsJumpYesterday}"
                              Tag="2"
                              Content="昨天"
                              Click="OnJumpRangeItemClick" />
                      <Button Classes="jump-item"
                              Classes.active="{Binding IsJumpLastWeek}"
                              Tag="3"
                              Content="上周"
                              Click="OnJumpRangeItemClick" />
                      <Button Classes="jump-item"
                              Classes.active="{Binding IsJumpLastMonth}"
                              Tag="4"
                              Content="上个月"
                              Click="OnJumpRangeItemClick" />
                      <Button Classes="jump-item"
                              Classes.active="{Binding IsJumpLastYear}"
                              Tag="6"
                              Content="去年"
                              Click="OnJumpRangeItemClick" />
                      <Button x:Name="DateFieldButton"
                              Classes="field-trigger"
                              AutomationProperties.Name="选择日期"
                              Margin="0,6,0,0"
                              Click="OnToggleDatePanelClick">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding CustomDateText}" VerticalAlignment="Center" />
                          <ic:FluentIcon Grid.Column="1"
                                         Icon="Calendar"
                                         IconSize="Size16"
                                         VerticalAlignment="Center" />
                        </Grid>
                      </Button>

                      <!-- 日期选择面板：显示在下拉菜单之外，单独浮层 -->
                      <Popup x:Name="DatePanel"
                             PlacementTarget="{Binding #DateFieldButton}"
                             Placement="RightEdgeAlignedTop"
                             HorizontalOffset="10"
                             IsOpen="{Binding IsDatePanelOpen, Mode=TwoWay}"
                             IsLightDismissEnabled="False"
                             Closed="OnDatePanelClosed">
                        <Border Background="{DynamicResource MailDogBrushSurfacePopup}"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 6 18 0 #55000000"
                                Padding="8">
                          <StackPanel Width="224" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                              <TextBlock Text="{Binding CalendarMonthText}"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Classes="icon"
                                      Command="{Binding PreviousMonthCommand}"
                                      ToolTip.Tip="上个月">
                                <ic:FluentIcon Icon="ChevronLeft" IconSize="Size16" />
                              </Button>
                              <Button Grid.Column="2"
                                      Classes="icon"
                                      Command="{Binding NextMonthCommand}"
                                      ToolTip.Tip="下个月">
                                <ic:FluentIcon Icon="ChevronRight" IconSize="Size16" />
                              </Button>
                            </Grid>
                            <UniformGrid Columns="7">
                              <TextBlock Text="日" Classes="calendar-weekday" />
                              <TextBlock Text="一" Classes="calendar-weekday" />
                              <TextBlock Text="二" Classes="calendar-weekday" />
                              <TextBlock Text="三" Classes="calendar-weekday" />
                              <TextBlock Text="四" Classes="calendar-weekday" />
                              <TextBlock Text="五" Classes="calendar-weekday" />
                              <TextBlock Text="六" Classes="calendar-weekday" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                  <Button Classes="calendar-cell"
                                          Classes.selected="{Binding IsSelected}"
                                          Classes.outside="{Binding !IsCurrentMonth}"
                                          Classes.today="{Binding IsToday}"
                                          Content="{Binding DayText}"
                                          Click="OnCalendarDayClick" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="应用"
                                    Command="{Binding ApplyCustomRangeCommand}"
                                    Click="OnApplyCustomRangeClick"
                                    HorizontalAlignment="Stretch" />
                          </StackPanel>
                        </Border>
                      </Popup>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="icon"
                      AutomationProperties.Name="筛选"
                      ToolTip.Tip="筛选">
                <ic:FluentIcon Icon="Filter" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="全部"
                              ToggleType="Radio"
                              GroupName="filter"
                              IsChecked="{Binding IsFilterAll, Mode=TwoWay}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="MailInbox" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="未读"
                              ToggleType="Radio"
                              GroupName="filter"
                              IsChecked="{Binding IsFilterUnread, Mode=TwoWay}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="MailUnread" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="已标记"
                              ToggleType="Radio"
                              GroupName="filter"
                              IsChecked="{Binding IsFilterFlagged, Mode=TwoWay}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Flag" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="带附件"
                              ToggleType="Radio"
                              GroupName="filter"
                              IsChecked="{Binding IsFilterAttachments, Mode=TwoWay}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Attach" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <Button Classes="icon"
                      AutomationProperties.Name="标签筛选"
                      ToolTip.Tip="{Binding TagFilterText}">
                <ic:FluentIcon Icon="Tag" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="全部邮件" Command="{Binding ClearTagFilterCommand}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="MailInbox" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="按标签筛选"
                              ItemsSource="{Binding TagFilters}"
                              IsEnabled="{Binding HasTags}">
                      <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagFilterViewModel">
                          <MenuItem Header="{Binding Name}" Command="{Binding SelectCommand}">
                            <MenuItem.Icon>
                              <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </DataTemplate>
                      </MenuItem.ItemTemplate>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <Button Classes="icon"
                      AutomationProperties.Name="排序"
                      ToolTip.Tip="排序">
                <ic:FluentIcon Icon="ArrowSort" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem IsHitTestVisible="False" Focusable="False">
                      <MenuItem.Header>
                        <TextBlock Text="排序依据"
                                   FontSize="12"
                                   Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="日期" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortByDate, Mode=TwoWay}" />
                    <MenuItem Header="发件人" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortBySender, Mode=TwoWay}" />
                    <MenuItem Header="类别" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortByCategory, Mode=TwoWay}" />
                    <MenuItem Header="大小" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortBySize, Mode=TwoWay}" />
                    <MenuItem Header="重要性" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortByImportance, Mode=TwoWay}" />
                    <MenuItem Header="主题" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortBySubject, Mode=TwoWay}" />
                    <MenuItem Header="类型" ToggleType="Radio" GroupName="sortField" IsChecked="{Binding IsSortByType, Mode=TwoWay}" />
                    <MenuItem IsHitTestVisible="False" Focusable="False">
                      <MenuItem.Header>
                        <TextBlock Text="排序顺序"
                                   FontSize="12"
                                   Foreground="{DynamicResource MailDogBrushTextTertiary}"
                                   Margin="0,10,0,0" />
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="由旧到新" ToggleType="Radio" GroupName="sortOrder" IsChecked="{Binding IsSortOldestFirst, Mode=TwoWay}" />
                    <MenuItem Header="由新到旧" ToggleType="Radio" GroupName="sortOrder" IsChecked="{Binding IsSortNewestFirst, Mode=TwoWay}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <Button Classes="icon"
                      AutomationProperties.Name="操作"
                      ToolTip.Tip="操作">
                <ic:FluentIcon Icon="MoreHorizontal" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="选择"
                              ToggleType="CheckBox"
                              IsChecked="{Binding IsSelectionMode, Mode=TwoWay}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Checkmark" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{Binding CheckedText}"
                              IsEnabled="False"
                              IsVisible="{Binding IsSelectionMode}" />
                    <MenuItem Header="标记为已读"
                              Command="{Binding MarkCheckedReadCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="MailRead" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="标记为未读"
                              Command="{Binding MarkCheckedUnreadCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="MailUnread" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="添加旗标"
                              Command="{Binding FlagCheckedCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Flag" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="取消旗标"
                              Command="{Binding UnflagCheckedCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Flag" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="批量归档"
                              Command="{Binding BatchArchiveCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Archive" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="批量移动到"
                              ItemsSource="{Binding BatchMoveTargets}"
                              IsEnabled="{Binding HasBatchMoveTargets}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Folder" IconSize="Size16" />
                      </MenuItem.Icon>
                      <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoveTargetViewModel">
                          <MenuItem Header="{Binding Name}"
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding FolderId}" />
                        </DataTemplate>
                      </MenuItem.ItemTemplate>
                    </MenuItem>
                    <MenuItem Header="标记为垃圾邮件"
                              Command="{Binding BatchMarkJunkCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Warning" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="添加标签"
                              ItemsSource="{Binding TagMenuTargets}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Tag" IconSize="Size16" />
                      </MenuItem.Icon>
                      <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagMenuViewModel">
                          <MenuItem Header="{Binding Name}" Command="{Binding AddCommand}" />
                        </DataTemplate>
                      </MenuItem.ItemTemplate>
                    </MenuItem>
                    <MenuItem Header="移除标签"
                              ItemsSource="{Binding TagMenuTargets}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagMenuViewModel">
                          <MenuItem Header="{Binding Name}" Command="{Binding RemoveCommand}" />
                        </DataTemplate>
                      </MenuItem.ItemTemplate>
                    </MenuItem>
                    <MenuItem Header="批量删除"
                              Command="{Binding BatchDeleteCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Delete" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="清除选择"
                              Command="{Binding ClearCheckedMessagesCommand}"
                              IsEnabled="{Binding HasCheckedMessages}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Dismiss" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="16,0,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Classes="single-line"
                     Padding="32,0,30,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="搜索邮件"
                     Text="{Binding SearchText}"
                     PlaceholderText="搜索邮件、发件人…" />
            <ic:FluentIcon Icon="Search"
                           IconSize="Size16"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource MailDogBrushTextTertiary}" />
            <Button Grid.Column="0"
                    Classes="icon sm"
                    HorizontalAlignment="Right"
                    Margin="0,0,4,0"
                    IsVisible="{Binding HasSearchText}"
                    Click="OnClearSearchClick"
                    ToolTip.Tip="清除搜索"
                    AutomationProperties.Name="清除搜索">
              <ic:FluentIcon Icon="Dismiss" IconSize="Size16" />
            </Button>
            <Button Grid.Column="1"
                    Classes="subtle sm"
                    Content="{Binding SearchScopeLabel}"
                    Click="OnToggleSearchScopeClick"
                    ToolTip.Tip="切换搜索范围：当前文件夹或全部邮箱"
                    AutomationProperties.Name="{Binding SearchScopeAutomationName}" />
          </Grid>

          <Border Grid.Row="2"
                  BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                  BorderThickness="0,0,0,1"
                  IsVisible="{Binding IsSelectionMode}"
                  IsEnabled="{Binding !IsBatchBusy}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,16,8">
              <CheckBox Content="全选"
                        FontSize="12"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsAllChecked}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding CheckedText}"
                         Classes="caption"
                         Margin="12,0"
                         VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Content="清除"
                      Command="{Binding ClearCheckedMessagesCommand}"
                      IsVisible="{Binding HasCheckedMessages}" />
            </Grid>
          </Border>

          <Grid Grid.Row="3">
            <ListBox x:Name="MailList"
                     Classes="mail-list"
                     Background="Transparent"
                     ItemsSource="{Binding Messages}"
                     SelectedItem="{Binding SelectedMessage}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MailSummaryViewModel">
                  <Grid ColumnDefinitions="12,Auto,Auto,*"
                        Height="{DynamicResource MailDogSizeMailRow}"
                        Margin="12,0"
                        AutomationProperties.Name="{Binding AccessibilityName}">
                    <Border Grid.Column="0"
                            Width="3"
                            Height="40"
                            CornerRadius="1.5"
                            Background="{DynamicResource MailDogBrushAccentBase}"
                            IsVisible="{Binding IsUnread}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsSelected}"
                              IsVisible="{Binding ShowSelection}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              AutomationProperties.Name="选择邮件" />
                    <Border Grid.Column="2"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{Binding AvatarBrush}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding AvatarInitial}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="3" Margin="12,0,0,0">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                          <TextBlock Text="{Binding Sender}"
                                     FontSize="14"
                                     FontWeight="{Binding SenderWeight}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Border Grid.Column="1"
                                  IsVisible="{Binding IsThreaded}"
                                  Background="{DynamicResource MailDogBrushAccentTint}"
                                  CornerRadius="7"
                                  Padding="4,0"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding ThreadLabel}">
                            <TextBlock Text="{Binding ThreadCount}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MailDogBrushAccentBase}" />
                          </Border>
                          <ic:FluentIcon Grid.Column="2"
                                        Icon="Attach"
                                        IconSize="Size16"
                                        IsVisible="{Binding HasAttachments}"
                                        Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                          <ic:FluentIcon Grid.Column="3"
                                        Icon="Flag"
                                        IconVariant="Filled"
                                        IconSize="Size16"
                                        IsVisible="{Binding IsFlagged}"
                                        Foreground="{DynamicResource MailDogBrushAccentBase}" />
                          <TextBlock Grid.Column="4"
                                     Text="{Binding TimeText}"
                                     FontSize="12"
                                     Foreground="{DynamicResource MailDogBrushTextTertiary}"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <controls:HighlightedTextBlock SourceText="{Binding DisplaySubject}"
                                                       Query="{Binding SearchQuery}"
                                                       FontSize="14"
                                                       FontWeight="{Binding SubjectWeight}"
                                                       TextTrimming="CharacterEllipsis" />
                        <Grid>
                          <TextBlock Text="{Binding Preview}"
                                     IsVisible="{Binding ShowPreviewRow}"
                                     FontSize="12"
                                     Foreground="{DynamicResource MailDogBrushTextSecondary}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <ItemsControl ItemsSource="{Binding Tags}"
                                        IsVisible="{Binding ShowTagRow}"
                                        MaxHeight="18">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MessageTagChipViewModel">
                                <Border Background="{Binding Background}"
                                        BorderBrush="{Binding Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,0"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}"
                                             FontSize="10"
                                             Foreground="{Binding Foreground}"
                                             TextTrimming="CharacterEllipsis"
                                             MaxWidth="90" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </StackPanel>

                      <Border IsVisible="{Binding IsHovered}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Background="{DynamicResource MailDogBrushSurfacePopup}"
                              BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                          <Button Classes="icon sm"
                                  Click="OnQuickArchiveClick"
                                  ToolTip.Tip="归档"
                                  AutomationProperties.Name="归档这封邮件">
                            <ic:FluentIcon Icon="Archive" IconSize="Size16" />
                          </Button>
                          <Button Classes="icon sm"
                                  Click="OnQuickToggleReadClick"
                                  ToolTip.Tip="{Binding ReadToggleLabel}"
                                  AutomationProperties.Name="{Binding ReadToggleAutomationName}">
                            <ic:FluentIcon Icon="{Binding ReadToggleIcon}" IconSize="Size16" />
                          </Button>
                          <Button Classes="icon sm"
                                  Click="OnQuickDeleteClick"
                                  ToolTip.Tip="删除"
                                  AutomationProperties.Name="删除这封邮件">
                            <ic:FluentIcon Icon="Delete" IconSize="Size16" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border IsVisible="{Binding IsEmpty}"
                    Background="{DynamicResource MailDogBrushSurfacePane}">
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="8">
                <ic:FluentIcon Icon="Mail"
                               IconSize="Size48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                <TextBlock Text="{Binding SearchEmptyTitle}"
                           FontSize="14"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SearchEmptyHint}"
                           Classes="caption"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <ProgressBar Grid.Row="4"
                       Height="2"
                       Margin="16,0"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsLoadingMore}" />
        </Grid>
      </Border>

      <!-- 阅读区 -->
      <Grid Grid.Column="2"
            RowDefinitions="Auto,*,Auto"
            Background="{DynamicResource MailDogBrushSurfaceContent}">
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto"
              Margin="16,16,16,0"
              IsVisible="{Binding Reader.HasSelection}">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="{Binding Reader.AvatarBrush}"
                    VerticalAlignment="Top">
              <TextBlock Text="{Binding Reader.AvatarInitial}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Classes="page-title"
                         Text="{Binding Reader.Subject}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Reader.SenderName}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Reader.SenderAddress}"
                         IsVisible="{Binding Reader.HasSenderAddress}"
                         FontSize="12"
                         Foreground="{DynamicResource MailDogBrushTextTertiary}"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Reader.DateText}"
                           FontSize="12"
                           Foreground="{DynamicResource MailDogBrushTextTertiary}"
                           VerticalAlignment="Center" />
                <Button IsVisible="{Binding SelectedMessage.IsThreaded}"
                        Classes="subtle sm"
                        Content="{Binding SelectedMessage.ThreadLabel}"
                        ToolTip.Tip="查看本会话的全部邮件"
                        AutomationProperties.Name="查看会话邮件">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                ItemsSource="{Binding SelectedMessage.ThreadMessages}">
                      <MenuFlyout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MailSummaryViewModel">
                          <MenuItem Header="{Binding ThreadMenuLabel}"
                                    Click="OnThreadMessageClick" />
                        </DataTemplate>
                      </MenuFlyout.ItemTemplate>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Border IsVisible="{Binding Reader.IsFromCache}"
                        Background="{DynamicResource MailDogBrushAccentTint}"
                        CornerRadius="4"
                        Padding="6,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="本地缓存"
                             FontSize="11"
                             Foreground="{DynamicResource MailDogBrushAccentBase}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1"
                      IsVisible="{Binding Reader.HasAttachments}"
                      Spacing="6"
                      Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="附件"
                         Classes="caption"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="4">
                <Button Content="全选"
                        Classes="subtle sm"
                        Command="{Binding Reader.SelectAllAttachmentsCommand}"
                        AutomationProperties.Name="全选附件" />
                <Button Content="取消全选"
                        Classes="subtle sm"
                        Command="{Binding Reader.ClearAttachmentSelectionCommand}"
                        AutomationProperties.Name="取消全选附件" />
                <Button Content="保存所选"
                        Classes="subtle sm"
                        Command="{Binding Reader.SaveSelectedAttachmentsCommand}"
                        IsEnabled="{Binding Reader.HasSelectedAttachments}"
                        AutomationProperties.Name="保存所选附件" />
                <Button Content="保存全部"
                        Classes="subtle sm"
                        Command="{Binding Reader.SaveAllAttachmentsCommand}"
                        AutomationProperties.Name="保存全部附件" />
                <Border Background="Transparent"
                        BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,3"
                        Cursor="Hand"
                        IsEnabled="{Binding Reader.HasSelectedAttachments}"
                        PointerPressed="OnAttachmentDragSelectedPressed"
                        ToolTip.Tip="把选中的附件拖到资源管理器">
                  <TextBlock Text="拖出所选"
                             FontSize="11"
                             AutomationProperties.Name="拖出所选附件" />
                </Border>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Reader.Attachments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AttachmentViewModel">
                  <Border Background="{DynamicResource MailDogBrushSurfaceSubtle}"
                          BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                          BorderThickness="1"
                          CornerRadius="8"
                          MinWidth="240"
                          MaxWidth="320"
                          Padding="10,8"
                          Margin="0,0,8,8">
                    <StackPanel Spacing="6">
                      <Border Background="{DynamicResource MailDogBrushSurfacePane}"
                              CornerRadius="4"
                              IsVisible="{Binding HasPreviewImage}"
                              ClipToBounds="True">
                        <Image Source="{Binding PreviewImage}"
                               MaxWidth="260"
                               MaxHeight="200"
                               Stretch="Uniform"
                               AutomationProperties.Name="附件图片预览" />
                      </Border>
                      <TextBlock Text="{Binding PreviewError}"
                                 IsVisible="{Binding HasPreviewError}"
                                 Classes="caption"
                                 TextWrapping="Wrap"
                                 MaxWidth="260" />
                      <Grid RowDefinitions="Auto,Auto"
                            ColumnDefinitions="Auto,Auto,*"
                            ColumnSpacing="8"
                            RowSpacing="6">
                        <CheckBox Grid.Row="0"
                                  Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="选中后可批量导出"
                                  AutomationProperties.Name="{Binding SelectAutomationName}" />
                        <ic:FluentIcon Grid.Row="0"
                                       Grid.Column="1"
                                       Icon="Attach"
                                       IconSize="Size16"
                                       VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Spacing="1">
                          <TextBlock Text="{Binding FileName}"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding FileName}" />
                          <TextBlock Text="{Binding SizeText}"
                                     Classes="caption" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                          <Button Content="打开"
                                  Classes="subtle sm"
                                  Command="{Binding PreviewCommand}"
                                  ToolTip.Tip="下载并用默认程序打开"
                                  AutomationProperties.Name="打开附件" />
                          <Button Content="下载"
                                  Classes="subtle sm"
                                  Command="{Binding DownloadCommand}"
                                  AutomationProperties.Name="下载附件" />
                          <Border Background="Transparent"
                                  BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Padding="6,2"
                                  Cursor="Hand"
                                  PointerPressed="OnAttachmentDragHandlePressed"
                                  ToolTip.Tip="拖到资源管理器">
                            <TextBlock Text="拖出"
                                       FontSize="11"
                                       AutomationProperties.Name="拖出附件" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
              <Button Command="{Binding ResumeDraftCommand}"
                      IsVisible="{Binding SelectedMessageInDrafts}"
                      Classes="icon toolbar"
                      ToolTip.Tip="继续编辑草稿"
                      AutomationProperties.Name="继续编辑草稿">
                <ic:FluentIcon Icon="Edit" IconSize="Size16" />
              </Button>
              <Button Command="{Binding ReplyCommand}"
                      Classes="icon toolbar"
                      ToolTip.Tip="回复"
                      AutomationProperties.Name="回复">
                <ic:FluentIcon Icon="ArrowReply" IconSize="Size16" />
              </Button>
              <Button Command="{Binding ReplyAllCommand}"
                      Classes="icon toolbar"
                      ToolTip.Tip="全部回复"
                      AutomationProperties.Name="全部回复">
                <ic:FluentIcon Icon="ArrowReplyAll" IconSize="Size16" />
              </Button>
              <Button Classes="icon toolbar"
                      IsVisible="{Binding HasQuickReplyTargets}"
                      ToolTip.Tip="快速回复模板"
                      AutomationProperties.Name="快速回复模板">
                <ic:FluentIcon Icon="Comment" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft"
                              ItemsSource="{Binding QuickReplyTargets}">
                    <MenuFlyout.ItemTemplate>
                      <DataTemplate x:DataType="vm:QuickReplyTargetViewModel">
                        <MenuItem Header="{Binding Name}" Command="{Binding ReplyCommand}" />
                      </DataTemplate>
                    </MenuFlyout.ItemTemplate>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Command="{Binding ForwardCommand}"
                      Classes="icon toolbar"
                      ToolTip.Tip="转发"
                      AutomationProperties.Name="转发">
                <ic:FluentIcon Icon="ArrowForward" IconSize="Size16" />
              </Button>
              <Button Command="{Binding ArchiveSelectedCommand}"
                      Classes="icon toolbar"
                      ToolTip.Tip="归档"
                      AutomationProperties.Name="归档">
                <ic:FluentIcon Icon="Archive" IconSize="Size16" />
              </Button>
              <Button x:Name="MoveButton"
                      Classes="icon toolbar"
                      IsEnabled="{Binding HasMoveTargets}"
                      ToolTip.Tip="移动到文件夹"
                      AutomationProperties.Name="移动到文件夹">
                <ic:FluentIcon Icon="Folder" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft"
                              ItemsSource="{Binding MoveTargets}">
                    <MenuFlyout.ItemTemplate>
                      <DataTemplate x:DataType="vm:MoveTargetViewModel">
                        <MenuItem Header="{Binding Name}"
                                  Command="{Binding Command}"
                                  CommandParameter="{Binding FolderId}" />
                      </DataTemplate>
                    </MenuFlyout.ItemTemplate>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="icon toolbar"
                      ToolTip.Tip="稍后提醒"
                      AutomationProperties.Name="稍后提醒">
                <ic:FluentIcon Icon="Clock" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="1 小时后"
                              Command="{Binding SnoozeSelectedCommand}"
                              CommandParameter="1h" />
                    <MenuItem Header="4 小时后"
                              Command="{Binding SnoozeSelectedCommand}"
                              CommandParameter="4h" />
                    <MenuItem Header="今晚 20:00"
                              Command="{Binding SnoozeSelectedCommand}"
                              CommandParameter="tonight" />
                    <MenuItem Header="明天 08:00"
                              Command="{Binding SnoozeSelectedCommand}"
                              CommandParameter="tomorrow" />
                    <MenuItem Header="周末 09:00"
                              Command="{Binding SnoozeSelectedCommand}"
                              CommandParameter="weekend" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Command="{Binding DeleteSelectedCommand}"
                      Classes="icon toolbar"
                      ToolTip.Tip="{Binding DeleteActionText}"
                      AutomationProperties.Name="{Binding DeleteActionText}">
                <ic:FluentIcon Icon="Delete" IconSize="Size16" />
              </Button>
              <Button Classes="icon toolbar"
                      ToolTip.Tip="更多操作"
                      AutomationProperties.Name="更多操作">
                <ic:FluentIcon Icon="MoreHorizontal" IconSize="Size16" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="导出为 .eml" Click="OnExportMessageClick">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="ArrowDownload" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="导出当前邮件为 PDF" Click="OnExportPdfClick" />
                    <MenuItem Header="导出整个会话为 PDF"
                              Click="OnExportThreadPdfClick"
                              IsEnabled="{Binding HasThreadMessages}" />
                    <MenuItem Header="打印当前邮件" Click="OnPrintMessageClick" />
                    <MenuItem Header="打印整个会话"
                              Click="OnPrintThreadClick"
                              IsEnabled="{Binding HasThreadMessages}" />
                    <Separator />
                    <MenuItem Header="标记为已读/未读" Command="{Binding ToggleReadCommand}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Mail" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="切换旗标" Command="{Binding ToggleFlagCommand}">
                      <MenuItem.Icon>
                        <ic:FluentIcon Icon="Flag" IconSize="Size16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0" RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  IsVisible="{Binding Reader.ImagesBlocked}"
                  Background="{DynamicResource MailDogBrushStatusWarningTint}"
                  BorderBrush="{DynamicResource MailDogBrushStatusWarning}"
                  BorderThickness="0,1,0,1"
                  Padding="16,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="远程图片已阻止"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="发件人可能通过图片跟踪阅读状态。"
                           FontSize="11"
                           Foreground="{DynamicResource MailDogBrushTextSecondary}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="显示图片"
                      Command="{Binding ShowImagesCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" IsVisible="{Binding Reader.IsPlainText}">
            <SelectableTextBlock Text="{Binding Reader.PlainText}"
                                 Margin="16,8,16,16"
                                 FontSize="14"
                                 TextWrapping="Wrap" />
          </ScrollViewer>

          <NativeWebView Grid.Row="1" x:Name="WebView" Margin="16,0,16,0" IsVisible="{Binding IsReaderHtmlVisible}" />

          <Border Grid.Row="1" IsVisible="{Binding Reader.ShowEmpty}"
                  Background="{DynamicResource MailDogBrushSurfacePane}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <ic:FluentIcon Icon="Mail"
                             IconSize="Size48"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource MailDogBrushTextTertiary}" />
              <TextBlock Text="{Binding ReaderEmptyTitle}"
                         FontSize="14"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ReaderEmptyHint}"
                         Classes="caption"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <ProgressBar Grid.Row="1"
                       IsIndeterminate="True"
                       Height="3"
                       VerticalAlignment="Top"
                       IsVisible="{Binding Reader.IsLoading}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="16,0,16,16" Spacing="8">
          <Border IsVisible="{Binding Reader.HasNotice}"
                  Background="{DynamicResource MailDogBrushStatusWarningTint}"
                  CornerRadius="6"
                  Padding="12,8">
            <TextBlock Text="{Binding Reader.Notice}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Border>

          <Border IsVisible="{Binding Reader.HasError}"
                  Background="{DynamicResource MailDogBrushStatusDangerTint}"
                  CornerRadius="6"
                  Padding="12,8">
            <TextBlock Text="{Binding Reader.Error}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MailDogBrushStatusDanger}" />
          </Border>
        </StackPanel>

      </Grid>

      <!-- 写邮件：覆盖中间邮件列表与右侧阅读区，保留左侧账户导航 -->
      <Border Grid.Row="1"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              ZIndex="10"
              IsVisible="{Binding IsComposeOpen}"
              Background="{DynamicResource MailDogBrushSurfacePopup}">
        <views:ComposeView DataContext="{Binding Compose}" />
      </Border>
    </Grid>

    <!-- 首次使用 -->
    <Border Grid.Row="1"
            Grid.ColumnSpan="3"
            IsVisible="{Binding IsWelcomeVisible}"
            Background="{DynamicResource MailDogBrushSurfaceWindow}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <Border Width="72"
                Height="72"
                CornerRadius="14"
                ClipToBounds="True"
                HorizontalAlignment="Center">
          <Image Source="avares://MailDog.UI/Assets/logo.png"
                 Width="72"
                 Height="72"
                 Stretch="UniformToFill" />
        </Border>
        <TextBlock Classes="page-title" Text="添加你的第一个邮箱账户"
                   HorizontalAlignment="Center" />
        <TextBlock Text="支持 Outlook 浏览器登录与 QQ 邮箱授权码。"
                   Classes="caption"
                   HorizontalAlignment="Center" />
        <Button Content="添加账户"
                Command="{Binding OpenAddAccountCommand}"
                HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <views:SettingsView Grid.Row="1"
                        Grid.ColumnSpan="3"
                        IsVisible="{Binding IsSettingsOpen}" />

    <Border Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            ZIndex="100"
            IsVisible="{Binding IsAppLocked}"
            Background="{DynamicResource MailDogBrushSurfaceWindow}">
      <StackPanel Width="320"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <Border Width="72"
                Height="72"
                CornerRadius="16"
                ClipToBounds="True"
                HorizontalAlignment="Center">
          <Image Source="avares://MailDog.UI/Assets/logo.png"
                 Width="72"
                 Height="72"
                 Stretch="UniformToFill" />
        </Border>
        <TextBlock Classes="page-title"
                   Text="MailDog 已锁定"
                   HorizontalAlignment="Center" />
        <TextBlock Text="输入 PIN 继续使用"
                   Classes="caption"
                   HorizontalAlignment="Center" />
        <TextBox x:Name="UnlockPinBox"
                 Text="{Binding LockPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PasswordChar="●"
                 MaxLength="32"
                 HorizontalAlignment="Stretch"
                 AutomationProperties.Name="应用锁 PIN" />
        <Button Content="解锁"
                Command="{Binding UnlockCommand}"
                HorizontalAlignment="Stretch"
                IsDefault="True" />
        <TextBlock Text="{Binding UnlockError}"
                   Foreground="{DynamicResource MailDogBrushStatusDanger}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   IsVisible="{Binding UnlockError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            IsVisible="{Binding IsStatusBarVisible}"
            Background="{DynamicResource MailDogBrushSurfaceSubtle}"
            BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
            BorderThickness="0,1,0,0"
            Padding="16,5">
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="12"
                 Foreground="{DynamicResource MailDogBrushTextSecondary}"
                 TextTrimming="CharacterEllipsis" />
    </Border>

  </Grid>
</Window>
