<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MailDog.UI.ViewModels"
        x:Class="MailDog.UI.Views.EmlViewerWindow"
        x:DataType="vm:EmlPreviewViewModel"
        Title="{Binding Title}"
        Width="900"
        Height="720"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MailDogBrushSurfaceSolid}">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Subject}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding FromText}" FontSize="13" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ToText}" Classes="caption" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding DateText}" Classes="caption" />
        <TextBlock Text="{Binding FileName}" Classes="caption" />
      </StackPanel>
      <TextBlock Text="{Binding AttachmentsText}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasAttachments}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
      <SelectableTextBlock Text="{Binding Body}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22" />
    </ScrollViewer>
    <TextBlock Grid.Row="2"
               Text="这是外部 .eml 的只读预览；回复、转发或保存请先在 MailDog 中导入。"
               Classes="caption"
               Margin="0,12,0,0"
               TextWrapping="Wrap" />
  </Grid>
</Window>
