<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MailDog.UI.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:MailDog.UI.Controls"
             x:Class="MailDog.UI.Views.ComposeView"
             x:DataType="vm:ComposeViewModel">

  <Grid RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource MailDogBrushSurfacePopup}">
  <Grid Grid.Row="0"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnDefinitions="*"
        Margin="24,14,24,0"
        RowSpacing="8">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding WindowTitle}"
                 Classes="page-title"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="4"
                  VerticalAlignment="Center">
        <Button Classes="icon"
                Command="{Binding DiscardCommand}"
                ToolTip.Tip="关闭（自动保存草稿）"
                AutomationProperties.Name="关闭撰写">
          <ic:FluentIcon Icon="Dismiss" IconSize="Size16" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="64,*">
      <TextBlock Text="发件人"
                 Classes="caption"
                 VerticalAlignment="Center" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Accounts}"
                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                IsEnabled="{Binding CanEdit}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ComposeAccount">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="64,*">
      <TextBlock Text="收件人"
                 Classes="caption"
                 VerticalAlignment="Top"
                 Margin="0,6,0,0" />
      <StackPanel Grid.Column="1" Spacing="4">
        <ItemsControl ItemsSource="{Binding ToRecipients}"
                      IsVisible="{Binding HasToRecipients}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipientChipViewModel">
              <Border Background="{DynamicResource MailDogBrushAccentTint}"
                      BorderBrush="{DynamicResource MailDogBrushAccentBase}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="8,2"
                      Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             MaxWidth="220"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Classes="icon sm"
                          Width="18"
                          Height="18"
                          MinWidth="0"
                          MinHeight="0"
                          Padding="0"
                          Command="{Binding RemoveCommand}"
                          ToolTip.Tip="移除收件人"
                          AutomationProperties.Name="{Binding RemoveAutomationName}">
                    <TextBlock Text="×" FontSize="12" HorizontalAlignment="Center" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="ToBox"
                 Classes="single-line"
                 Text="{Binding ToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="多个地址用分号或逗号分隔"
                 IsEnabled="{Binding CanEdit}" />
        <Border IsVisible="{Binding HasToSuggestions}"
                Background="{DynamicResource MailDogBrushSurfacePopup}"
                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
          <ItemsControl ItemsSource="{Binding ToSuggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecipientSuggestionViewModel">
                <Button Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Padding="8,4"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding SelectAutomationName}">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="64,*,64,*">
      <TextBlock Text="抄送"
                 Classes="caption"
                 VerticalAlignment="Top"
                 Margin="0,6,0,0" />
      <StackPanel Grid.Column="1" Spacing="4">
        <ItemsControl ItemsSource="{Binding CcRecipients}"
                      IsVisible="{Binding HasCcRecipients}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipientChipViewModel">
              <Border Background="{DynamicResource MailDogBrushAccentTint}"
                      BorderBrush="{DynamicResource MailDogBrushAccentBase}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="8,2"
                      Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             MaxWidth="180"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Classes="icon sm"
                          Width="18"
                          Height="18"
                          MinWidth="0"
                          MinHeight="0"
                          Padding="0"
                          Command="{Binding RemoveCommand}"
                          ToolTip.Tip="移除收件人"
                          AutomationProperties.Name="{Binding RemoveAutomationName}">
                    <TextBlock Text="×" FontSize="12" HorizontalAlignment="Center" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="CcBox"
                 Classes="single-line"
                 Text="{Binding CcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="可选"
                 IsEnabled="{Binding CanEdit}" />
        <Border IsVisible="{Binding HasCcSuggestions}"
                Background="{DynamicResource MailDogBrushSurfacePopup}"
                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
          <ItemsControl ItemsSource="{Binding CcSuggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecipientSuggestionViewModel">
                <Button Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Padding="8,4"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding SelectAutomationName}">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <TextBlock Grid.Column="2"
                 Text="密送"
                 Classes="caption"
                 Margin="12,6,0,0"
                 VerticalAlignment="Top" />
      <StackPanel Grid.Column="3" Spacing="4">
        <ItemsControl ItemsSource="{Binding BccRecipients}"
                      IsVisible="{Binding HasBccRecipients}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipientChipViewModel">
              <Border Background="{DynamicResource MailDogBrushAccentTint}"
                      BorderBrush="{DynamicResource MailDogBrushAccentBase}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="8,2"
                      Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             MaxWidth="160"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Classes="icon sm"
                          Width="18"
                          Height="18"
                          MinWidth="0"
                          MinHeight="0"
                          Padding="0"
                          Command="{Binding RemoveCommand}"
                          ToolTip.Tip="移除收件人"
                          AutomationProperties.Name="{Binding RemoveAutomationName}">
                    <TextBlock Text="×" FontSize="12" HorizontalAlignment="Center" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="BccBox"
                 Classes="single-line"
                 Text="{Binding BccText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="可选"
                 IsEnabled="{Binding CanEdit}" />
        <Border IsVisible="{Binding HasBccSuggestions}"
                Background="{DynamicResource MailDogBrushSurfacePopup}"
                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
          <ItemsControl ItemsSource="{Binding BccSuggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecipientSuggestionViewModel">
                <Button Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Padding="8,4"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding SelectAutomationName}">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="64,*">
      <TextBlock Text="主题"
                 Classes="caption"
                 VerticalAlignment="Center" />
      <TextBox Grid.Column="1"
               Classes="single-line"
               Text="{Binding SubjectText, Mode=TwoWay}"
               PlaceholderText="邮件主题"
               IsEnabled="{Binding CanEdit}" />
    </Grid>

    <TextBlock Grid.Row="5"
               Text="正文"
               Classes="caption"
               VerticalAlignment="Center" />

    <WrapPanel Grid.Row="6"
               x:Name="FormatToolbar"
               Orientation="Horizontal"
               IsEnabled="{Binding CanEdit}">
      <Button Classes="icon toolbar"
              Tag="bold"
              Click="OnFormatCommandClick"
              ToolTip.Tip="加粗（Ctrl+B）"
              AutomationProperties.Name="加粗">
        <ic:FluentIcon Icon="TextBold" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="italic"
              Click="OnFormatCommandClick"
              ToolTip.Tip="斜体（Ctrl+I）"
              AutomationProperties.Name="斜体">
        <ic:FluentIcon Icon="TextItalic" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="underline"
              Click="OnFormatCommandClick"
              ToolTip.Tip="下划线（Ctrl+U）"
              AutomationProperties.Name="下划线">
        <ic:FluentIcon Icon="TextUnderline" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="strike"
              Click="OnFormatCommandClick"
              ToolTip.Tip="删除线"
              AutomationProperties.Name="删除线">
        <ic:FluentIcon Icon="TextStrikethrough" IconSize="Size16" />
      </Button>

      <Border Width="1"
              Height="18"
              Margin="4,0,8,0"
              Background="{DynamicResource MailDogBrushStrokeSubtle}"
              VerticalAlignment="Center" />

      <Button Classes="icon toolbar"
              Tag="heading1"
              Click="OnFormatCommandClick"
              ToolTip.Tip="标题 1"
              AutomationProperties.Name="标题 1">
        <TextBlock Text="H1" FontSize="12" FontWeight="SemiBold" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="heading2"
              Click="OnFormatCommandClick"
              ToolTip.Tip="标题 2"
              AutomationProperties.Name="标题 2">
        <TextBlock Text="H2" FontSize="12" FontWeight="SemiBold" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="heading3"
              Click="OnFormatCommandClick"
              ToolTip.Tip="标题 3"
              AutomationProperties.Name="标题 3">
        <TextBlock Text="H3" FontSize="12" FontWeight="SemiBold" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="bodyText"
              Click="OnFormatCommandClick"
              ToolTip.Tip="正文"
              AutomationProperties.Name="正文">
        <TextBlock Text="正文" FontSize="11" />
      </Button>

      <Border Width="1"
              Height="18"
              Margin="4,0,8,0"
              Background="{DynamicResource MailDogBrushStrokeSubtle}"
              VerticalAlignment="Center" />

      <Button Classes="icon toolbar"
              Tag="bulletList"
              Click="OnFormatCommandClick"
              ToolTip.Tip="项目符号列表"
              AutomationProperties.Name="项目符号列表">
        <ic:FluentIcon Icon="TextBulletList" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="orderedList"
              Click="OnFormatCommandClick"
              ToolTip.Tip="编号列表"
              AutomationProperties.Name="编号列表">
        <ic:FluentIcon Icon="TextNumberList" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="blockquote"
              Click="OnFormatCommandClick"
              ToolTip.Tip="引用"
              AutomationProperties.Name="引用">
        <ic:FluentIcon Icon="TextQuote" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="link"
              Click="OnFormatCommandClick"
              ToolTip.Tip="插入链接（Ctrl+K）"
              AutomationProperties.Name="插入链接">
        <ic:FluentIcon Icon="Link" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="image"
              Click="OnFormatCommandClick"
              ToolTip.Tip="插入图片"
              AutomationProperties.Name="插入图片">
        <ic:FluentIcon Icon="Image" IconSize="Size16" />
      </Button>

      <Border Width="1"
              Height="18"
              Margin="4,0,8,0"
              Background="{DynamicResource MailDogBrushStrokeSubtle}"
              VerticalAlignment="Center" />

      <Button Classes="icon toolbar"
              Tag="undo"
              Click="OnFormatCommandClick"
              ToolTip.Tip="撤销"
              AutomationProperties.Name="撤销">
        <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" />
      </Button>
      <Button Classes="icon toolbar"
              Tag="redo"
              Click="OnFormatCommandClick"
              ToolTip.Tip="重做"
              AutomationProperties.Name="重做">
        <ic:FluentIcon Icon="ArrowRedo" IconSize="Size16" />
      </Button>
    </WrapPanel>

  </Grid>

    <Grid Grid.Row="1"
          x:Name="BodyArea"
          ColumnDefinitions="*"
          Margin="24,10,24,10">
      <Grid Grid.Column="0" x:Name="EditorPane">
        <Border x:Name="RichEditorFrame"
                Background="{DynamicResource MailDogBrushSurfacePopup}"
                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MailDogRadiusCard}"
                Padding="12,10"
                ClipToBounds="True">
          <controls:MailDogRichEditor x:Name="RichEditor"
                          MinHeight="160"
                          AllowImages="True"
                          AllowTables="False"
                          AllowRichPaste="True"
                          AutoLinkOnType="True"
                          DefaultFontFamily="Segoe UI Variable Text"
                          DefaultFontSize="10.5"
                          DefaultForeground="{DynamicResource MailDogBrushTextPrimary}"
                          CaretBrush="{DynamicResource MailDogBrushTextPrimary}"
                          SelectionBrush="{DynamicResource MailDogBrushAccentTint}"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="邮件正文" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource MailDogBrushSurfacePopup}"
            BorderBrush="{DynamicResource MailDogBrushStrokeSubtle}"
            BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8"
            Margin="24,10,24,16">
        <Grid ColumnDefinitions="*,Auto">
          <Grid Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="{Binding AttachmentSummaryText}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !HasAttachments}" />
            <ScrollViewer IsVisible="{Binding HasAttachments}"
                          ToolTip.Tip="{Binding AttachmentSummaryText}"
                          MaxHeight="102"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComposeAttachmentViewModel">
                    <Border Background="{DynamicResource MailDogBrushSurfaceSubtle}"
                            BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="0,0,6,6"
                            ToolTip.Tip="{Binding FileName}"
                            VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Document" IconSize="Size16" />
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="12"
                                   MaxWidth="120"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Classes="icon sm"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="移除附件"
                                AutomationProperties.Name="移除附件">
                          <ic:FluentIcon Icon="Dismiss" IconSize="Size16" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Button Grid.Column="1"
                  Padding="8,0"
                  Click="AddAttachment_Click"
                  IsEnabled="{Binding CanEdit}"
                  AutomationProperties.Name="添加附件"
                  ToolTip.Tip="添加附件">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:FluentIcon Icon="Attach" IconSize="Size16" />
              <TextBlock Text="附件"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !HasAttachments}" />
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
          <Border IsVisible="{Binding HasError}"
                  Background="{DynamicResource MailDogBrushStatusDangerTint}"
                  CornerRadius="6"
                  Padding="10,7">
            <TextBlock Text="{Binding Error}"
                       Foreground="{DynamicResource MailDogBrushStatusDanger}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Border>

          <Border IsVisible="{Binding HasStatus}"
                  Background="{DynamicResource MailDogBrushAccentTint}"
                  CornerRadius="6"
                  Padding="10,7">
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource MailDogBrushAccentBase}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6">
          <Button Padding="8,0"
                  Command="{Binding SaveDraftCommand}"
                  IsEnabled="{Binding CanEdit}"
                  AutomationProperties.Name="保存草稿">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:FluentIcon Icon="Save" IconSize="Size16" FontSize="14" />
              <TextBlock Text="保存草稿" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="primary"
                  Padding="8,0"
                  Command="{Binding SendCommand}"
                  IsEnabled="{Binding CanSend}"
                  AutomationProperties.Name="发送邮件">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:FluentIcon Icon="Send" IconSize="Size16" FontSize="14" />
              <TextBlock Text="发送" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

