<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MailDog.UI.ViewModels"
        x:Class="MailDog.UI.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="设置"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="12">
      <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />

      <TextBlock Text="外观" Classes="section" Margin="0,8,0,0" />
      <ComboBox ItemsSource="{Binding ThemeOptions}"
                SelectedIndex="{Binding ThemeIndex}"
                Width="200"
                HorizontalAlignment="Left" />

      <CheckBox Content="新邮件通知"
                IsChecked="{Binding NotificationsEnabled}" />

      <TextBlock Text="Outlook" Classes="section" Margin="0,8,0,0" />
      <TextBox Text="{Binding EntraClientId}"
               PlaceholderText="Entra client id" />
      <TextBlock Text="在 Azure Portal 注册公共客户端应用，重定向 URI 填 http://localhost 与 http://127.0.0.1。"
                 Classes="caption"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="保存" Command="{Binding SaveSettingsCommand}" />
      <Button Content="关闭" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
