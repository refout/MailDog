<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:MailDog.UI.Controls"
             xmlns:vm="using:MailDog.UI.ViewModels"
             x:Class="MailDog.UI.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <Border IsVisible="{Binding IsSettingsOpen}"
            Background="{DynamicResource MailDogBrushSurfaceSolid}">
      <Grid ColumnDefinitions="220,*">
        <Border Background="{DynamicResource MailDogBrushSurfaceSubtle}"
                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                BorderThickness="0,0,1,0">
          <ListBox Classes="settings-nav"
                   SelectedIndex="{Binding SettingsSectionIndex}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="8">
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Settings" IconSize="Size16" />
                    <TextBlock Text="外观" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Alert" IconSize="Size16" />
                    <TextBlock Text="通知" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="DocumentText" IconSize="Size16" />
                    <TextBlock Text="阅读" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" />
                    <TextBlock Text="同步" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Mail" IconSize="Size16" />
                    <TextBlock Text="账户管理" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Folder" IconSize="Size16" />
                    <TextBlock Text="本地文件" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Play" IconSize="Size16" />
                    <TextBlock Text="启动" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="ArrowDownload" IconSize="Size16" />
                    <TextBlock Text="工具" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="DocumentText" IconSize="Size16" />
                    <TextBlock Text="模板" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Tag" IconSize="Size16" />
                    <TextBlock Text="标签" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Info" IconSize="Size16" />
                    <TextBlock Text="关于" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                  <controls:PageHeader Title="{Binding OverlayTitle}"
                                       BackCommand="{Binding BackFromOverlayCommand}" />
                  <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="64,24,32,16"
                                MaxWidth="900"
                                Spacing="24">
                      <StackPanel IsVisible="{Binding IsAppearanceSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="外观" />

                        <StackPanel Spacing="6">
                          <TextBlock Text="主题" FontSize="13" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="theme"
                                         Content="跟随系统"
                                         IsChecked="{Binding IsThemeSystem}" />
                            <RadioButton GroupName="theme"
                                         Content="浅色"
                                         IsChecked="{Binding IsThemeLight}" />
                            <RadioButton GroupName="theme"
                                         Content="深色"
                                         IsChecked="{Binding IsThemeDark}" />
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                          <TextBlock Text="界面密度" FontSize="13" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="density"
                                         Content="紧凑"
                                         IsChecked="{Binding IsCompactDensity}" />
                            <RadioButton GroupName="density"
                                         Content="标准"
                                         IsChecked="{Binding IsNormalDensity}" />
                          </StackPanel>
                          <TextBlock Text="紧凑档行高更小，一屏能多看几封邮件；标准档按钮和输入框更高。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsWindowsMaterialAvailable}">
                          <TextBlock Text="背景材质" FontSize="13" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="material"
                                         Content="无"
                                         IsChecked="{Binding IsMaterialNone}" />
                            <RadioButton GroupName="material"
                                         Content="云母"
                                         IsChecked="{Binding IsMaterialMica}" />
                            <RadioButton GroupName="material"
                                         Content="亚克力"
                                         IsChecked="{Binding IsMaterialAcrylic}" />
                          </StackPanel>
                          <TextBlock Text="云母仅 Windows 11 支持；不可用时自动回退为纯色。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                          <TextBlock Text="背景颜色" FontSize="13" />
                          <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding BackgroundPresets}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BackgroundPresetViewModel">
                                  <Button Width="36"
                                          Height="36"
                                          Margin="0,0,8,8"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          AutomationProperties.Name="{Binding Name}"
                                          Command="{Binding SelectCommand}"
                                          ToolTip.Tip="{Binding Name}">
                                    <Grid Width="30" Height="30">
                                      <Border CornerRadius="7"
                                              Background="{Binding Brush}"
                                              BorderBrush="{DynamicResource MailDogBrushStrokeStrong}"
                                              BorderThickness="1" />
                                      <Border Width="14"
                                              Height="14"
                                              CornerRadius="7"
                                              Background="{DynamicResource MailDogBrushAccentBase}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,-3,-3"
                                              IsVisible="{Binding IsSelected}">
                                        <TextBlock Text="✓"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                      </Border>
                                    </Grid>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Width="36"
                                    Height="36"
                                    Margin="0,0,8,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AutomationProperties.Name="自定义颜色"
                                    ToolTip.Tip="自定义颜色">
                              <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                  <ColorView Color="{Binding BackgroundColorValue, Mode=TwoWay}"
                                             IsAlphaEnabled="False"
                                             IsHexInputVisible="False"
                                             IsColorComponentsVisible="False"
                                             IsAccentColorsVisible="False"
                                             Width="320" />
                                </Flyout>
                              </Button.Flyout>
                              <Grid Width="30" Height="30">
                                <Border CornerRadius="7"
                                        BorderBrush="{DynamicResource MailDogBrushStrokeStrong}"
                                        BorderThickness="1">
                                  <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                      <GradientStop Offset="0" Color="#F25022" />
                                      <GradientStop Offset="0.25" Color="#FFB900" />
                                      <GradientStop Offset="0.5" Color="#7FBA00" />
                                      <GradientStop Offset="0.75" Color="#00A4EF" />
                                      <GradientStop Offset="1" Color="#B4009E" />
                                    </LinearGradientBrush>
                                  </Border.Background>
                                  <TextBlock Text="+"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                                <Border Width="14"
                                        Height="14"
                                        CornerRadius="7"
                                        Background="{DynamicResource MailDogBrushAccentBase}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-3,-3"
                                        IsVisible="{Binding IsCustomBackgroundSelected}">
                                  <TextBlock Text="✓"
                                             FontSize="9"
                                             Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                            </Button>
                          </StackPanel>
                          <TextBlock Text="直接点击颜色块即可应用，最后一个色块可自定义任意颜色。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="背景不透明度" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding OpacityText}" Classes="caption" />
                          </Grid>
                          <Slider Minimum="40"
                                  Maximum="100"
                                  Value="{Binding BackgroundOpacityValue}"
                                  AutomationProperties.Name="背景不透明度" />
                          <TextBlock Text="低于 100% 时窗口背景透出桌面；启用材质时控制材质强度。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsNotificationsSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="通知" />
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="新邮件通知" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding NotificationsEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          AutomationProperties.Name="新邮件通知" />
                          </Grid>
                          <StackPanel Spacing="8" IsEnabled="{Binding NotificationsEnabled}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="通知声音" FontSize="13" VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding NotificationSoundEnabled}"
                                            OnContent=""
                                            OffContent=""
                                            AutomationProperties.Name="通知声音" />
                            </Grid>
                            <TextBlock Text="关闭声音后仍然弹出通知，只是不播放提示音。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="显示邮件主题" FontSize="13" VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding NotificationShowSubject}"
                                            OnContent=""
                                            OffContent=""
                                            AutomationProperties.Name="显示邮件主题" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="显示正文摘要" FontSize="13" VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding NotificationShowPreview}"
                                            OnContent=""
                                            OffContent=""
                                            AutomationProperties.Name="显示正文摘要" />
                            </Grid>
                            <TextBlock Text="关掉主题后只显示发件人和一句“收到一封新邮件”；摘要取正文开头几十个字。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="通知节奏" Classes="section" Margin="0,8,0,0" />
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <TextBlock Text="多封合并" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="同一批到达好几封时只弹一条“收到 N 封新邮件”，点它跳到最新一封。"
                                           Classes="caption"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding NotificationMerge}"
                                            OnContent=""
                                            OffContent=""
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="多封合并" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <TextBlock Text="只通知收件箱" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="订阅文件夹和自定义文件夹的新邮件照常入库，只是不弹窗。"
                                           Classes="caption"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding NotificationInboxOnly}"
                                            OnContent=""
                                            OffContent=""
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="只通知收件箱" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <TextBlock Text="免打扰时段" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="这段时间只收信不弹窗，醒来再在列表里看。"
                                           Classes="caption"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding NotificationQuietEnabled}"
                                            OnContent=""
                                            OffContent=""
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="免打扰时段" />
                            </Grid>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsEnabled="{Binding NotificationQuietEnabled}">
                              <TextBox Width="88"
                                       Text="{Binding NotificationQuietStart}"
                                       PlaceholderText="22:00"
                                       AutomationProperties.Name="免打扰开始时间" />
                              <TextBlock Text="到" VerticalAlignment="Center" />
                              <TextBox Width="88"
                                       Text="{Binding NotificationQuietEnd}"
                                       PlaceholderText="08:00"
                                       AutomationProperties.Name="免打扰结束时间" />
                              <TextBlock Text="24 小时制；结束早于开始表示跨夜。"
                                         Classes="caption"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8"
                                    IsEnabled="{Binding NotificationsEnabled}">
                          <StackPanel Spacing="8"
                                      IsEnabled="{Binding NotificationSoundEnabled}">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                              <TextBlock Text="通知铃声" Classes="section" VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="试听"
                                      Command="{Binding PreviewNotificationSoundCommand}"
                                      Margin="12,0,0,0" />
                            </Grid>
                            <WrapPanel ItemWidth="96" ItemHeight="32">
                              <RadioButton GroupName="sound"
                                           Content="默认"
                                           IsChecked="{Binding IsSoundDefault}" />
                              <RadioButton GroupName="sound"
                                           Content="邮件"
                                           IsChecked="{Binding IsSoundMail}" />
                              <RadioButton GroupName="sound"
                                           Content="提醒"
                                           IsChecked="{Binding IsSoundReminder}" />
                              <RadioButton GroupName="sound"
                                           Content="提示"
                                           IsChecked="{Binding IsSoundAsterisk}" />
                              <RadioButton GroupName="sound"
                                           Content="警告"
                                           IsChecked="{Binding IsSoundWarning}" />
                              <RadioButton GroupName="sound"
                                           Content="蜂鸣"
                                           IsChecked="{Binding IsSoundBeep}" />
                              <RadioButton GroupName="sound"
                                           Content="询问"
                                           IsChecked="{Binding IsSoundQuestion}" />
                              <RadioButton GroupName="sound"
                                           Content="启动"
                                           IsChecked="{Binding IsSoundStart}" />
                            </WrapPanel>
                            <TextBlock Text="按账户铃声" Classes="section" Margin="0,8,0,0" />
                            <TextBlock Text="账户可以单独选择铃声或静音；没有单独设置的账户跟随上面的全局铃声。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AccountSoundSettings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountSoundViewModel">
                                  <Grid ColumnDefinitions="*,180" Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotificationSoundOption">
                                          <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="添加账户后这里会自动出现对应条目。"
                                       Classes="caption"
                                       IsVisible="{Binding !HasAccountSoundSettings}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsReadingSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="阅读" />
                        <StackPanel Spacing="8">
                          <TextBlock Text="渲染方式" Classes="section" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="renderMode"
                                         Content="全量渲染（HTML）"
                                         IsChecked="{Binding IsHtmlRenderMode}"
                                         IsVisible="{Binding IsHtmlRenderAvailable}" />
                            <RadioButton GroupName="renderMode"
                                         Content="纯文本"
                                         IsChecked="{Binding IsPlainRenderMode}" />
                          </StackPanel>
                          <TextBlock Text="纯文本模式只显示文本内容；邮件没有纯文本段时会从 HTML 提取文本。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="Linux 的 HTML 阅读使用系统 WebKitGTK（libwebkit2gtk-4.1）；缺少该库时自动退回纯文本。"
                                     Classes="caption"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding IsLinuxPlatform}" />
                          <TextBlock Text="当前平台暂不加载 HTML 渲染器，邮件正文以纯文本显示。"
                                     Classes="caption"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding !IsHtmlRenderAvailable}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                          <TextBlock Text="打开行为" Classes="section" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="打开邮件时标记为已读" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding MarkReadOnOpen}"
                                          OnContent=""
                                          OffContent=""
                                          AutomationProperties.Name="打开邮件时标记为已读" />
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="默认显示远程图片" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ShowRemoteImages}"
                                          OnContent=""
                                          OffContent=""
                                          AutomationProperties.Name="默认显示远程图片" />
                          </Grid>
                          <TextBlock Text="远程图片可能被发件人用作阅读统计；关闭后仍可在单封邮件顶部临时显示。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsSyncSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="同步" />
                        <StackPanel Spacing="8">
                          <TextBlock Text="同步间隔" FontSize="13" />
                          <WrapPanel>
                            <RadioButton GroupName="sync"
                                         Content="1 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync1Minute}" />
                            <RadioButton GroupName="sync"
                                         Content="5 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync5Minutes}" />
                            <RadioButton GroupName="sync"
                                         Content="15 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync15Minutes}" />
                            <RadioButton GroupName="sync"
                                         Content="30 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync30Minutes}" />
                            <RadioButton GroupName="sync"
                                         Content="60 分钟"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSync60Minutes}" />
                          </WrapPanel>
                          <TextBlock Text="间隔越短越及时，也会更频繁地连接邮箱服务器。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                          <TextBlock Text="已发送副本" Classes="section" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="发送成功后保存到“已发送”文件夹"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding SaveSentCopy}"
                                          OnContent=""
                                          OffContent=""
                                          AutomationProperties.Name="发送成功后保存到已发送文件夹" />
                          </Grid>
                          <TextBlock Text="部分邮箱（如 Gmail）会在服务器端自动保存已发送副本，重复保存会出现两封相同邮件，可按需要关闭。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                          <TextBlock Text="延迟发送" Classes="section" />
                          <TextBlock Text="发出后留一段撤销窗口：这段时间里邮件停在发件箱，点撤回不会真正发出去。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <WrapPanel>
                            <RadioButton GroupName="senddelay"
                                         Content="立即"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSendDelayNone}" />
                            <RadioButton GroupName="senddelay"
                                         Content="5 秒"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSendDelay5Seconds}" />
                            <RadioButton GroupName="senddelay"
                                         Content="10 秒"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSendDelay10Seconds}" />
                            <RadioButton GroupName="senddelay"
                                         Content="30 秒"
                                         Margin="0,0,16,4"
                                         IsChecked="{Binding IsSendDelay30Seconds}" />
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="账号健康" Classes="section" />
                            <Button Grid.Column="1"
                                    Classes="link"
                                    Command="{Binding RefreshAccountHealthCommand}"
                                    AutomationProperties.Name="刷新账号健康">
                              <TextBlock Text="刷新" TextDecorations="Underline" />
                            </Button>
                          </Grid>
                          <TextBlock Text="每行显示最近一次成功同步、IDLE 连接状态，以及失败后的退避时间。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding AccountHealthStatus}"
                                     Classes="caption"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding AccountHealthStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="还没有账户。"
                                     Classes="caption"
                                     IsVisible="{Binding !HasAccountHealth}" />
                          <ItemsControl ItemsSource="{Binding AccountHealth}" IsVisible="{Binding HasAccountHealth}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AccountHealthViewModel">
                                <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10"
                                        Margin="0,0,0,2">
                                  <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}" Classes="caption" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                          <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                          <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastSyncText}" Classes="caption" TextAlignment="Right" />
                                      </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding IdleText}" Classes="caption" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ErrorText}"
                                               Classes="caption"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasError}" />
                                    <TextBlock Text="{Binding FailuresText}"
                                               Classes="caption"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasFailures}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                          <TextBlock Text="来信规则" Classes="section" Margin="0,8,0,0" />
                          <TextBlock Text="新邮件到达时按关键词自动处理：标已读、加旗标、移入垃圾邮件，或者不弹通知。规则只对之后收到的邮件生效，也不会删除邮件。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="还没有规则。下面加一条试试。"
                                     Classes="caption"
                                     IsVisible="{Binding HasNoRules}" />
                          <ItemsControl ItemsSource="{Binding Rules}" IsVisible="{Binding HasRules}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:RuleViewModel">
                                <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10"
                                        Margin="0,0,0,2">
                                  <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Title}"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis" />
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding ActionLabel}" Classes="caption" />
                                        <TextBlock Text="·" Classes="caption" />
                                        <TextBlock Text="{Binding HitsLabel}" Classes="caption" />
                                      </StackPanel>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled}"
                                                  OnContent=""
                                                  OffContent=""
                                                  AutomationProperties.Name="启用规则" />
                                    <Button Grid.Column="2"
                                            Classes="icon sm subtle"
                                            Command="{Binding DeleteCommand}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="删除规则"
                                            AutomationProperties.Name="删除规则">
                                      <ic:FluentIcon Icon="Delete" IconSize="Size16" />
                                    </Button>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                  BorderThickness="1"
                                  CornerRadius="6"
                                  Padding="12">
                            <StackPanel Spacing="10">
                              <TextBlock Text="新增规则" FontSize="13" FontWeight="SemiBold" />
                              <Grid ColumnDefinitions="*,180" ColumnSpacing="8">
                                <TextBox Text="{Binding NewRulePattern}"
                                         PlaceholderText="关键词，例如 noreply@ 或 账单"
                                         AutomationProperties.Name="规则关键词" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding RuleAccounts}"
                                          SelectedItem="{Binding SelectedRuleAccount}">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleAccountOption">
                                      <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                              </Grid>
                              <WrapPanel>
                                <RadioButton GroupName="rulefield"
                                             Content="发件人"
                                             Margin="0,0,16,4"
                                             IsChecked="{Binding IsRuleFieldFrom}" />
                                <RadioButton GroupName="rulefield"
                                             Content="主题"
                                             Margin="0,0,16,4"
                                             IsChecked="{Binding IsRuleFieldSubject}" />
                                <RadioButton GroupName="rulefield"
                                             Content="主题或发件人"
                                             Margin="0,0,16,4"
                                             IsChecked="{Binding IsRuleFieldAny}" />
                              </WrapPanel>
                              <WrapPanel>
                                <CheckBox Content="标为已读"
                                          Margin="0,0,16,4"
                                          IsChecked="{Binding NewRuleMarkRead}" />
                                <CheckBox Content="加旗标"
                                          Margin="0,0,16,4"
                                          IsChecked="{Binding NewRuleFlag}" />
                                <CheckBox Content="不弹通知"
                                          Margin="0,0,16,4"
                                          IsChecked="{Binding NewRuleMute}" />
                                <CheckBox Content="移入垃圾邮件"
                                          Margin="0,0,16,4"
                                          IsChecked="{Binding NewRuleMoveToJunk}" />
                              </WrapPanel>
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary"
                                        Content="添加规则"
                                        Command="{Binding AddRuleCommand}"
                                        AutomationProperties.Name="添加来信规则" />
                                <TextBlock Text="{Binding RuleHint}"
                                           Classes="caption"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasRuleHint}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsAccountSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="账户管理" />
                        <StackPanel Spacing="8" IsVisible="{Binding HasAccounts}">
                          <TextBlock Text="按账户签名" Classes="section" />
                          <TextBlock Text="为每个发件账户设置独立签名；留空则使用下方的默认签名。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <ComboBox ItemsSource="{Binding Accounts}"
                                    SelectedItem="{Binding SelectedSignatureAccount, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:AccountViewModel">
                                <TextBlock Text="{Binding Email}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBox Text="{Binding AccountSignatureText, Mode=TwoWay}"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="72"
                                   MaxHeight="140"
                                   VerticalContentAlignment="Top"
                                   PlaceholderText="留空则使用默认签名" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding HasAccounts}">
                          <TextBlock Text="发信身份（别名）" Classes="section" />
                          <TextBlock Text="同一个账户可以添加多个已在邮箱服务商处验证的别名地址。发信仍使用该账户的 SMTP 登录，只替换邮件头里的发件人与签名；服务商不允许的别名会被拒绝。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding AccountIdentities}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AccountIdentityViewModel">
                                <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10"
                                        Margin="0,0,0,4">
                                  <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                      <TextBox Text="{Binding Address, Mode=TwoWay}"
                                               PlaceholderText="别名邮箱地址"
                                               />
                                      <TextBox Grid.Column="1"
                                               Text="{Binding DisplayName, Mode=TwoWay}"
                                               PlaceholderText="显示名（可留空）"
                                               />
                                    </Grid>
                                    <TextBox Text="{Binding Signature, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="52"
                                             MaxHeight="110"
                                             VerticalContentAlignment="Top"
                                             PlaceholderText="该身份的签名；留空则使用账户签名"
                                             />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <Button Content="保存"
                                              Command="{Binding SaveCommand}"

                                              AutomationProperties.Name="保存发信身份" />
                                      <Button Content="删除"
                                              Command="{Binding DeleteCommand}"

                                              AutomationProperties.Name="删除发信身份" />
                                      <TextBlock Text="{Binding Label}"
                                                 Classes="caption"
                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="当前账户还没有别名身份；账户主地址始终可以直接发信。"
                                     Classes="caption"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding !HasAccountIdentities}" />
                          <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                  BorderThickness="1"
                                  CornerRadius="6"
                                  Padding="12">
                            <StackPanel Spacing="8">
                              <TextBlock Text="添加别名身份" Classes="caption" />
                              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Text="{Binding NewIdentityAddress, Mode=TwoWay}"
                                         PlaceholderText="别名邮箱地址" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewIdentityName, Mode=TwoWay}"
                                         PlaceholderText="显示名（可留空）" />
                              </Grid>
                              <TextBox Text="{Binding NewIdentitySignature, Mode=TwoWay}"
                                       AcceptsReturn="True"
                                       TextWrapping="Wrap"
                                       MinHeight="52"
                                       MaxHeight="110"
                                       VerticalContentAlignment="Top"
                                       PlaceholderText="该身份的签名（可留空）" />
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary"
                                        Content="添加身份"
                                        Command="{Binding AddIdentityCommand}"
                                        AutomationProperties.Name="添加发信身份" />
                                <TextBlock Text="{Binding IdentityHint}"
                                           Classes="caption"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasIdentityHint}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                          <TextBlock Text="默认邮件签名" Classes="section" />
                          <TextBlock Text="新写、回复和转发时自动插入到正文下方；留空则不插入。账户没有单独签名时使用这里的内容。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                          <TextBox Text="{Binding SignatureText, Mode=TwoWay}"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="88"
                                   MaxHeight="160"
                                   VerticalContentAlignment="Top"
                                   PlaceholderText="例如：张三｜产品经理｜138 0000 0000" />
                          <TextBlock Text="按纯文本保存，换行会保留。"
                                     Classes="caption" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsAccountListVisible}" Spacing="12">
                        <TextBlock Text="邮箱账户" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountViewModel">
                              <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,12"
                                      Margin="0,0,0,2">
                                <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <Border Width="40"
                                          Height="40"
                                          CornerRadius="20"
                                          Background="{DynamicResource MailDogBrushAccentBase}">
                                    <TextBlock Text="{Binding Initial}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MailDogBrushTextOnAccent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Border>
                                  <StackPanel Grid.Column="1"
                                              Margin="12,0"
                                              VerticalAlignment="Center"
                                              Spacing="2">
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <TextBlock Text="{Binding ProviderText}" Classes="caption" />
                                      <TextBlock Text="·" Classes="caption" />
                                      <TextBlock Text="{Binding StatusText}"
                                                 FontSize="11"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding StatusBrush}" />
                                    </StackPanel>
                                    <Border IsVisible="{Binding IsDefault}"
                                            Background="{DynamicResource MailDogBrushAccentTint}"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            HorizontalAlignment="Left">
                                      <TextBlock Text="默认发信"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource MailDogBrushAccentBase}" />
                                    </Border>
                                    <TextBlock Text="{Binding SyncStatus}"
                                               Classes="caption"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding HasSyncStatus}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2"
                                              Orientation="Horizontal"
                                              Spacing="2"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center">
                                    <Button Classes="icon sm subtle"
                                            Click="OnMoveAccountUpClick"

                                            ToolTip.Tip="上移"
                                            AutomationProperties.Name="上移账户">
                                      <ic:FluentIcon Icon="ArrowUp" IconSize="Size16" />
                                    </Button>
                                    <Button Classes="icon sm subtle"
                                            Click="OnMoveAccountDownClick"

                                            ToolTip.Tip="下移"
                                            AutomationProperties.Name="下移账户">
                                      <ic:FluentIcon Icon="ArrowDown" IconSize="Size16" />
                                    </Button>
                                    <Button Classes="subtle"
                                            Padding="8,0"
                                            Content="重新授权"
                                            Click="OnReauthorizeAccountClick"
                                            IsVisible="{Binding CanReauthorize}"

                                            AutomationProperties.Name="重新授权账户" />
                                    <Button Classes="subtle"
                                            Padding="8,0"
                                            Content="设为默认"
                                            Click="OnSetDefaultAccountClick"
                                            IsVisible="{Binding !IsDefault}"

                                            AutomationProperties.Name="设为默认发信账户" />
                                    <Button Classes="subtle"
                                            Padding="8,0"
                                            Content="编辑"
                                            Click="OnEditAccountClick"

                                            AutomationProperties.Name="编辑账户" />
                                    <Button Classes="danger"
                                            Padding="8,0"
                                            Content="删除"
                                            Click="OnDeleteAccountClick"

                                            AutomationProperties.Name="删除账户" />
                                  </StackPanel>
                                </Grid>

                                <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                                        Background="{DynamicResource MailDogBrushStatusDangerTint}"
                                        BorderBrush="{DynamicResource MailDogBrushStatusDanger}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10">
                                  <StackPanel Spacing="8">
                                    <TextBlock Text="删除后只会移除本地账户、缓存和凭据，不会删除服务器上的邮件或草稿；该账户尚未发出的邮件也会从发件箱移除。"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MailDogBrushStatusDanger}" />
                                    <TextBlock Text="{Binding DeleteError}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MailDogBrushStatusDanger}"
                                               IsVisible="{Binding HasDeleteError}" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                      <Button Content="取消"
                                              Click="OnCancelDeleteAccountClick"
                                              />
                                      <Button Content="确认删除"
                                              Classes="danger"
                                              Click="OnConfirmDeleteAccountClick"
                                              />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="还没有添加任何账户。"
                                   Classes="caption"
                                   IsVisible="{Binding !HasAccounts}" />

                        <Button Content="添加账户"
                                Command="{Binding BeginAddAccountCommand}"
                                HorizontalAlignment="Left" />
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsAddAccountFormVisible}" Spacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="page-title" Text="{Binding AccountFormTitle}" />
                          <TextBlock Text="{Binding AccountFormDescription}" Classes="caption" />
                        </StackPanel>

                        <Button Content="返回账户列表"
                                Command="{Binding ShowAccountListCommand}"
                                HorizontalAlignment="Left" />

                        <ComboBox ItemsSource="{Binding ProviderOptions}"
                                  SelectedIndex="{Binding SelectedProviderIndex}"
                                  IsEnabled="{Binding IsProviderSelectorEnabled}"
                                  HorizontalAlignment="Stretch" />

                        <TextBox Text="{Binding AddAccountEmail}"
                                 Classes="single-line"
                                 PlaceholderText="邮箱地址"
                                 IsReadOnly="{Binding IsEditingAccount}" />

                        <TextBox Text="{Binding AddAccountDisplayName}"
                                 Classes="single-line"
                                 PlaceholderText="发件人名称（可选，默认使用邮箱地址）" />

                        <TextBox Text="{Binding AddAccountSecret}"
                                 Classes="single-line"
                                 PlaceholderText="{Binding AccountSecretPlaceholder}"
                                 PasswordChar="●"
                                 IsVisible="{Binding IsPasswordProvider}" />

                        <TextBlock Text="授权码不是 QQ 密码。请先在 QQ 邮箱设置中开启 IMAP/SMTP 并生成授权码。"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsQqProvider}" />

                        <StackPanel IsVisible="{Binding IsCustomProvider}" Spacing="8">
                          <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                            <TextBox Text="{Binding CustomImapHost}"
                                     Classes="single-line"
                                     PlaceholderText="IMAP 服务器，如 imap.example.com" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomImapPortText}"
                                     Classes="single-line"
                                     PlaceholderText="993" />
                          </Grid>
                          <CheckBox Content="IMAP 使用 STARTTLS（端口通常为 143）"
                                    IsChecked="{Binding CustomImapStartTls}" />
                          <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                            <TextBox Text="{Binding CustomSmtpHost}"
                                     Classes="single-line"
                                     PlaceholderText="SMTP 服务器，如 smtp.example.com" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomSmtpPortText}"
                                     Classes="single-line"
                                     PlaceholderText="465" />
                          </Grid>
                          <CheckBox Content="SMTP 使用 STARTTLS（端口通常为 587）"
                                    IsChecked="{Binding CustomSmtpStartTls}" />
                          <TextBlock Text="不勾选 STARTTLS 时使用 SSL 直连，常用端口 IMAP 993、SMTP 465。"
                                     Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Content="{Binding AccountSubmitText}"
                                Command="{Binding SaveAccountCommand}"
                                IsVisible="{Binding IsAccountSaveVisible}"
                                HorizontalAlignment="Stretch" />

                        <Button Content="使用浏览器登录"
                                Command="{Binding StartOAuthCommand}"
                                IsVisible="{Binding IsOAuthLoginVisible}"
                                HorizontalAlignment="Stretch" />

                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     IsVisible="{Binding IsAddingAccount}" />

                        <TextBlock Text="{Binding AddAccountStatus}"
                                   Classes="caption"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsStorageSection}" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="page-title" Text="本地文件" />
                          <Button Grid.Column="1"
                                  Content="刷新"
                                  Command="{Binding RefreshStorageCommand}"
                                  IsEnabled="{Binding !IsStorageBusy}"
                                  VerticalAlignment="Top" />
                        </Grid>

                        <StackPanel Spacing="10">
                            <TextBlock Text="占用" Classes="section" />

                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="邮件数据库（含 WAL）"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageDatabaseSizeText}"
                                         FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="正文与索引"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageIndexText}"
                                         FontSize="13"
                                         HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="附件缓存"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageAttachmentSizeText}"
                                         FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="发件箱附件"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageOutboxSizeText}"
                                         FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="日志"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageLogSizeText}"
                                         FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="原生库"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageNativeSizeText}"
                                         FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="临时文件"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageTempSizeText}"
                                         FontSize="13" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="合计"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StorageTotalSizeText}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding StoragePendingOutboxText}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="目录" Classes="section" />
                            <TextBlock Text="打开目录会使用系统文件管理器；删除文件前请确认 MailDog 已退出相关预览程序。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <TextBlock Text="数据" Width="44" FontSize="13" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageDataDirectory}"
                                         FontSize="12"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding StorageDataDirectory}"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="2"
                                      Content="打开"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding StorageDataDirectory}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <TextBlock Text="日志" Width="44" FontSize="13" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageLogDirectory}"
                                         FontSize="12"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding StorageLogDirectory}"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="2"
                                      Content="打开"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding StorageLogDirectory}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <TextBlock Text="附件" Width="44" FontSize="13" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageAttachmentCacheDirectory}"
                                         FontSize="12"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding StorageAttachmentCacheDirectory}"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="2"
                                      Content="打开"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding StorageAttachmentCacheDirectory}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <TextBlock Text="发件箱" Width="44" FontSize="13" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StorageOutboxDirectory}"
                                         FontSize="12"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding StorageOutboxDirectory}"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="2"
                                      Content="打开"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding StorageOutboxDirectory}" />
                            </Grid>
                          </StackPanel>

                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="发件箱" Classes="section" />
                              <Button Grid.Column="1"
                                      Content="刷新"
                                      Click="OnRefreshOutboxClick"
                                      IsEnabled="{Binding !IsOutboxBusy}" />
                            </Grid>
                            <TextBlock Text="{Binding OutboxStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         IsVisible="{Binding IsOutboxBusy}" />
                            <TextBlock Text="没有待发送或发送失败的邮件。"
                                       Classes="caption"
                                       IsVisible="{Binding !HasOutboxItems}" />
                            <ItemsControl ItemsSource="{Binding OutboxItems}"
                                          IsVisible="{Binding HasOutboxItems}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutboxItemViewModel">
                                  <Border Margin="0,0,0,8"
                                          Padding="10"
                                          CornerRadius="6"
                                          Background="{DynamicResource MailDogBrushSurfacePane}"
                                          BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                          BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                      <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Subject}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ToAddresses}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MailDogBrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Text="{Binding StatusText}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource MailDogBrushStatusWarning}" />
                                          <TextBlock Text="{Binding AttachmentText}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                                          <TextBlock Text="{Binding CreatedText}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource MailDogBrushTextTertiary}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MailDogBrushTextSecondary}"
                                                   TextWrapping="Wrap" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="1"
                                                  Orientation="Horizontal"
                                                  Spacing="6"
                                                  VerticalAlignment="Center">
                                        <Button Content="重试"
                                                Click="OnRetryOutboxClick"
                                                IsEnabled="{Binding CanRetry}" />
                                        <Button Content="删除"
                                                Classes="danger"
                                                Click="OnDeleteOutboxClick"
                                                IsEnabled="{Binding CanDelete}" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="备份与恢复" Classes="section" />
                            <TextBlock Text="备份会生成包含本地数据库的 ZIP。填写密码则生成 AES-256-GCM 加密的 .mdog 备份；恢复只在下次启动 Engine 时替换数据库，启动前会先复制当前数据库。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding BackupPassword, Mode=TwoWay}"
                                     PasswordChar="●"
                                     PlaceholderText="备份密码（留空则生成普通 ZIP）"
                                     MaxLength="128" />
                            <WrapPanel>
                              <Button Content="创建备份"
                                      Click="OnCreateBackupClick"
                                      IsEnabled="{Binding !IsBackupBusy}"
                                      Margin="0,0,8,8" />
                              <Button Content="从备份恢复"
                                      Click="OnRestoreBackupClick"
                                      IsEnabled="{Binding !IsBackupBusy}"
                                      Margin="0,0,0,8" />
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         IsVisible="{Binding IsBackupBusy}" />
                            <TextBlock Text="{Binding BackupStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="清理" Classes="section" />
                            <TextBlock Text="只清理可再生缓存，不会删除数据库、草稿、旗标邮件或待发送邮件；当前日志文件会保留。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                              <Button Content="清理附件缓存"
                                      Command="{Binding CleanAttachmentCacheCommand}"
                                      IsEnabled="{Binding !IsStorageBusy}"
                                      Margin="0,0,8,8" />
                              <Button Content="清理旧日志"
                                      Command="{Binding CleanLogsCommand}"
                                      IsEnabled="{Binding !IsStorageBusy}"
                                      Margin="0,0,8,8" />
                              <Button Content="清理临时文件"
                                      Command="{Binding CleanTempFilesCommand}"
                                      IsEnabled="{Binding !IsStorageBusy}"
                                      Margin="0,0,0,8" />
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         IsVisible="{Binding IsStorageBusy}" />
                            <TextBlock Text="{Binding StorageStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                      </StackPanel>

                        <StackPanel IsVisible="{Binding IsStartupSection}" Spacing="16">
                          <TextBlock Classes="page-title" Text="启动" />

                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding StartupTitle}"
                                         FontSize="13"
                                         VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding RunAtStartup}"
                                            OnContent=""
                                            OffContent=""
                                            AutomationProperties.Name="{Binding StartupTitle}" />
                            </Grid>
                            <TextBlock Text="{Binding StartupDescription}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                          <StackPanel Spacing="8">
                            <TextBlock Text="应用锁" Classes="section" />
                            <TextBlock Text="开启后，启动应用或空闲超时需要输入 PIN 才能继续操作。PIN 只保存派生哈希，不保存明文；它不能替代磁盘加密。修改后需点“保存应用锁设置”才会生效。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="启用应用锁" FontSize="13" VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding AppLockEnabled}"
                                            OnContent=""
                                            OffContent=""
                                            AutomationProperties.Name="启用应用锁" />
                            </Grid>
                            <TextBlock Text="当前 PIN（修改或关闭时需要）"
                                       Classes="caption" />
                            <TextBox Text="{Binding AppLockCurrentPin, Mode=TwoWay}"
                                     PasswordChar="●"
                                     MaxLength="32"
                                     PlaceholderText="未设置过可留空" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                              <StackPanel Spacing="4">
                                <TextBlock Text="新 PIN（至少 4 位）" Classes="caption" />
                                <TextBox Text="{Binding AppLockPin, Mode=TwoWay}"
                                         PasswordChar="●"
                                         MaxLength="32"
                                         PlaceholderText="留空表示保持现有 PIN" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="确认新 PIN" Classes="caption" />
                                <TextBox Text="{Binding AppLockPinConfirm, Mode=TwoWay}"
                                         PasswordChar="●"
                                         MaxLength="32"
                                         PlaceholderText="再次输入" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="自动锁定" Classes="caption" />
                            <ComboBox SelectedIndex="{Binding AppLockTimeoutIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      MinWidth="180">
                              <ComboBoxItem Content="仅启动时锁定" />
                              <ComboBoxItem Content="空闲 5 分钟" />
                              <ComboBoxItem Content="空闲 15 分钟" />
                              <ComboBoxItem Content="空闲 30 分钟" />
                              <ComboBoxItem Content="空闲 60 分钟" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="保存应用锁设置"
                                      Command="{Binding SaveAppLockCommand}"
                                      AutomationProperties.Name="保存应用锁设置" />
                              <Button Content="立即锁定"
                                      Command="{Binding LockNowCommand}"
                                      IsEnabled="{Binding HasAppLockPin}"
                                      AutomationProperties.Name="立即锁定" />
                            </StackPanel>
                            <TextBlock Text="{Binding AppLockStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding AppLockStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </StackPanel>

                      <StackPanel IsVisible="{Binding IsToolsSection}" Spacing="16">
                          <TextBlock Classes="page-title" Text="工具" />

                          <StackPanel Spacing="10">
                            <TextBlock Text="命令行工具" Classes="section" />
                            <TextBlock Text="CLI 不随安装包预装。点击后下载并解压到软件安装目录，得到 maildog 命令和 maildog-cli Skill；不会自动修改 PATH。解压成功后压缩包会删除，失败时保留以便重试。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <Button Content="下载 CLI + Skill"
                                    Command="{Binding DownloadCliCommand}"
                                    IsEnabled="{Binding !IsDownloadingCli}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="下载 CLI 与 Skill" />
                            <TextBlock Text="{Binding CliDownloadStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CliDownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                              <TextBlock Text="保存位置："
                                         Classes="caption"
                                         VerticalAlignment="Top" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding CliDownloadDirectory}"
                                         Classes="caption"
                                         TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="给智能体的说明"
                                         Classes="caption"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="复制全部"
                                      Click="OnCopyCliInfoClick"
                                      IsEnabled="{Binding HasCliDownload}"
                                      AutomationProperties.Name="复制 CLI 信息给智能体" />
                            </Grid>
                            <TextBox Text="{Binding CliAgentInfo}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     MaxHeight="260"
                                     FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ToolTip.Tip="只读文本，可选中后复制，或点右上角“复制全部”。"
                                     AutomationProperties.Name="给智能体的 CLI 说明" />
                            <TextBlock Text="{Binding CliCopyStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CliCopyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="调用记录（摘要 + 带 --json 的完整输出）："
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="摘要日志："
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CliUsageLogDisplayPath}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="JSON 记录："
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CliCallsLogDisplayPath}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <Button Content="查看调用记录"
                                    Click="OnOpenCliCallsClick"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="查看 CLI 调用记录" />
                          </StackPanel>
                        </StackPanel>

                      <StackPanel IsVisible="{Binding IsTemplatesSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="邮件模板" />
                        <TextBlock Text="模板可以保存常用正文和主题，在撰写页一键插入；勾选“快速回复”后会出现在阅读页的回复菜单中。"
                                   Classes="caption"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="已保存模板" Classes="section" VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="新建模板"
                                  Command="{Binding NewTemplateCommand}"
                                  AutomationProperties.Name="新建邮件模板" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Templates}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MailTemplateViewModel">
                              <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                  <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                      <Border Background="{DynamicResource MailDogBrushAccentTint}"
                                              CornerRadius="4"
                                              Padding="5,1">
                                        <TextBlock Text="{Binding KindText}" FontSize="11" />
                                      </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subject}"
                                               Classes="caption"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding Subject, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding Preview}"
                                               Classes="caption"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="编辑"
                                            Classes="subtle sm"
                                            Command="{Binding EditCommand}" />
                                    <Button Content="删除"
                                            Classes="subtle sm"
                                            Command="{Binding DeleteCommand}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border IsVisible="{Binding IsTemplateEditorOpen}"
                                Background="{DynamicResource MailDogBrushSurfaceSubtle}"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                          <StackPanel Spacing="10">
                            <TextBlock Text="{Binding TemplateEditorTitle}" Classes="section" />
                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                              <TextBlock Text="名称" VerticalAlignment="Center" />
                              <TextBox Grid.Column="1"
                                       Text="{Binding TemplateName, Mode=TwoWay}"
                                       PlaceholderText="例如：客户跟进" />
                              <TextBlock Grid.Row="1" Text="主题" VerticalAlignment="Center" />
                              <TextBox Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding TemplateSubject, Mode=TwoWay}"
                                       PlaceholderText="可选；留空则保留当前主题" />
                              <CheckBox Grid.Row="2"
                                        Grid.Column="1"
                                        Content="出现在阅读页的快速回复菜单中"
                                        IsChecked="{Binding TemplateIsQuickReply}" />
                            </Grid>
                            <TextBlock Text="正文（支持变量：&#123;&#123;date&#125;&#125;、&#123;&#123;time&#125;&#125;、&#123;&#123;account&#125;&#125;、&#123;&#123;email&#125;&#125;、&#123;&#123;subject&#125;&#125;）"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding TemplateBody, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"
                                     MaxHeight="240"
                                     VerticalContentAlignment="Top"
                                     PlaceholderText="例如：您好，关于 {{subject}}，我们已收到您的来信。" />
                            <TextBlock Text="{Binding TemplateHint}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding TemplateHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="保存模板" Command="{Binding SaveTemplateCommand}" />
                              <Button Content="取消" Classes="subtle" Command="{Binding CancelTemplateEditCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsTagsSection}" Spacing="16">
                        <TextBlock Classes="page-title" Text="标签" />
                        <TextBlock Text="标签只保存在本地数据库，不会同步到邮件服务器。用颜色区分客户、项目或待办。"
                                   Classes="caption"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="已保存标签" Classes="section" VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="新建标签"
                                  Command="{Binding NewTagCommand}"
                                  AutomationProperties.Name="新建标签" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Tags}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagViewModel">
                              <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                  <Border Width="14"
                                          Height="14"
                                          CornerRadius="7"
                                          Background="{Binding Brush}"
                                          VerticalAlignment="Center" />
                                  <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ColorHint}" Classes="caption" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="编辑"
                                            Classes="subtle sm"
                                            Command="{Binding EditCommand}"
                                            IsVisible="{Binding !DeleteConfirmVisible}" />
                                    <Button Content="删除"
                                            Classes="subtle sm"
                                            Command="{Binding AskDeleteCommand}"
                                            IsVisible="{Binding !DeleteConfirmVisible}" />
                                    <Button Content="确认删除"
                                            Classes="subtle sm"
                                            Command="{Binding ConfirmDeleteCommand}"
                                            IsVisible="{Binding DeleteConfirmVisible}" />
                                    <Button Content="取消"
                                            Classes="subtle sm"
                                            Command="{Binding CancelDeleteCommand}"
                                            IsVisible="{Binding DeleteConfirmVisible}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="还没有标签。新建后可在选择模式下给邮件打标签。"
                                   Classes="caption"
                                   IsVisible="{Binding !HasTags}" />

                        <Border IsVisible="{Binding IsTagEditorOpen}"
                                Background="{DynamicResource MailDogBrushSurfaceSubtle}"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                          <StackPanel Spacing="10">
                            <TextBlock Text="{Binding TagEditorTitle}" Classes="section" />
                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                              <TextBlock Text="名称" VerticalAlignment="Center" />
                              <TextBox Grid.Column="1"
                                       Text="{Binding TagName, Mode=TwoWay}"
                                       PlaceholderText="例如：客户跟进" />
                              <TextBlock Grid.Row="1" Text="颜色" VerticalAlignment="Center" />
                              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBox Width="110"
                                         Text="{Binding TagColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="#0F7B0F" />
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="6"
                                        Background="{Binding TagColorBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="格式 #RRGGBB" Classes="caption" VerticalAlignment="Center" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding TagHint}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding TagHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="保存标签" Command="{Binding SaveTagCommand}" />
                              <Button Content="取消" Classes="subtle" Command="{Binding CancelTagEditCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding IsAboutSection}"
                                  Spacing="0"
                                  MaxWidth="880"
                                  HorizontalAlignment="Left">
                        <TextBlock Classes="page-title"
                                   Text="关于"
                                   Margin="0,0,0,20" />

                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,20">
                          <Border Width="80"
                                  Height="80"
                                  CornerRadius="18"
                                  ClipToBounds="True"
                                  VerticalAlignment="Top">
                            <Image Source="avares://MailDog.UI/Assets/logo.png"
                                   Width="80"
                                   Height="80"
                                   Stretch="UniformToFill" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="20,4,0,0" Spacing="6">
                            <TextBlock Text="MailDog" FontSize="24" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="{Binding VersionText}"
                                         Classes="caption"
                                         VerticalAlignment="Center" />
                              <Button Classes="link"
                                      Command="{Binding CheckUpdateCommand}"
                                      IsEnabled="{Binding !IsUpdateBusy}"
                                      AutomationProperties.Name="检查更新">
                                <TextBlock Text="检查更新" TextDecorations="Underline" />
                              </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding IsUpdateStatusVisible}">
                              <TextBlock Text="{Binding UpdateStatusText}"
                                         Classes="caption"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                              <Button Classes="link"
                                      Command="{Binding RunUpdateActionCommand}"
                                      IsVisible="{Binding HasUpdateAvailable}"
                                      IsEnabled="{Binding !IsUpdateBusy}"
                                      AutomationProperties.Name="下载更新">
                                <TextBlock Text="{Binding UpdateActionText}" TextDecorations="Underline" />
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </Grid>

                        <TextBlock TextWrapping="Wrap"
                                   LineHeight="20"
                                   Text="MailDog 是一款本地优先的桌面邮件客户端，邮件收取、阅读与存储均在本机完成，不经过第三方中转服务器。" />

                        <Border Margin="0,22,0,0"
                                Padding="0,20,0,0"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="0,1,0,0">
                          <StackPanel Spacing="10">
                            <TextBlock Text="软件信息" Classes="section" />
                            <Grid ColumnDefinitions="120,*">
                              <TextBlock Text="适用平台"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding PlatformText}"
                                         FontSize="13"
                                         TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*">
                              <TextBlock Text="数据存储"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DataDirectoryText}"
                                         FontSize="13"
                                         TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*">
                              <TextBlock Text="网络通信"
                                         FontSize="13"
                                         Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              <TextBlock Grid.Column="1"
                                         Text="邮件收发仅连接已添加账户的 IMAP / SMTP 服务"
                                         FontSize="13"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </StackPanel>
                        </Border>

                        <Border Margin="0,22,0,0"
                                Padding="0,20,0,0"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="0,1,0,0">
                          <StackPanel Spacing="0">
                            <Button Classes="subtle"
                                    Command="{Binding ToggleThirdPartyNoticesCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    MinHeight="24"
                                    AutomationProperties.Name="第三方许可">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="第三方许可"
                                           Classes="section"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ThirdPartyNoticesToggleText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MailDogBrushAccentBase}"
                                           VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                            <StackPanel IsVisible="{Binding IsThirdPartyNoticesExpanded}"
                                        Spacing="8"
                                        Margin="0,10,0,0">
                              <TextBlock Text="各组件的许可条款由其自身提供，本项目不改变这些条款。"
                                         Classes="caption"
                                         TextWrapping="Wrap" />
                              <Grid ColumnDefinitions="240,*,90" Margin="0,8,0,0">
                                <TextBlock Text="组件"
                                           FontSize="12"
                                           Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                                <TextBlock Grid.Column="1"
                                           Text="用途"
                                           FontSize="12"
                                           Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                                <TextBlock Grid.Column="2"
                                           Text="许可证"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding ThirdPartyNotices}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ThirdPartyNoticeViewModel">
                                    <Border BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,7">
                                      <Grid ColumnDefinitions="240,*,90">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Purpose}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MailDogBrushTextSecondary}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding License}"
                                                   FontSize="13"
                                                   TextAlignment="Right" />
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="完整组件、版本与间接依赖见仓库中的 docs/THIRD-PARTY-NOTICES.md。"
                                         Classes="caption"
                                         TextWrapping="Wrap"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                          </StackPanel>
                        </Border>

                        <Border Margin="0,22,0,0"
                                Padding="0,20,0,0"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="0,1,0,0"
                                IsVisible="{Binding IsLinuxPlatform}">
                          <StackPanel Spacing="10">
                            <TextBlock Text="后台进程" Classes="section" />
                            <TextBlock Text="Linux 的托盘入口取决于桌面环境；关闭窗口后后台仍会继续收信。要彻底退出，用下面的按钮，或下载 CLI 后运行 maildog quit。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <Button Content="退出后台"
                                    Command="{Binding QuitBackgroundCommand}"
                                    IsEnabled="{Binding !IsBackgroundExiting}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding BackgroundExitStatus}"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasBackgroundExitStatus}" />
                          </StackPanel>
                        </Border>

                        <Border Margin="0,22,0,0"
                                Padding="0,20,0,0"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="0,1,0,0"
                                IsVisible="{Binding IsWindowsPlatform}">
                          <StackPanel Spacing="10">
                            <TextBlock Text="Windows 集成" Classes="section" />
                            <TextBlock Text="已注册 mailto: 与 .eml 打开方式，并把 MailDog 加入“默认应用”候选和资源管理器“发送到”。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <Button Content="打开默认应用设置"
                                    Command="{Binding OpenDefaultAppsSettingsCommand}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="打开默认应用设置" />
                            <TextBlock Text="Windows 不允许程序静默抢占默认关联，需要在系统设置里选一次 MailDog。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Margin="0,22,0,0"
                                Padding="0,20,0,0"
                                BorderBrush="{DynamicResource MailDogBrushStrokeDefault}"
                                BorderThickness="0,1,0,0">
                          <StackPanel Spacing="12">
                            <TextBlock Text="支持" Classes="section" />
                            <TextBlock Text="使用中遇到问题，可在项目主页提交 Issue。"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="6">
                              <Button Content="导出诊断包"
                                      Command="{Binding ExportDiagnosticsCommand}"
                                      IsEnabled="{Binding !IsExportingDiagnostics}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="导出诊断包" />
                              <TextBlock Text="包含版本、脱敏配置、账号状态和最近的引擎日志；不含邮件正文、口令与令牌。"
                                         Classes="caption"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding DiagnosticsStatus}"
                                         Classes="caption"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding DiagnosticsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <Button Classes="link"
                                    Command="{Binding OpenProjectPageCommand}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="打开项目主页">
                              <TextBlock Text="打开项目主页" TextDecorations="Underline" />
                            </Button>
                            <TextBlock Text="版权所有 © 2026 MailDog。Windows 与 .NET 是 Microsoft Corporation 的商标或注册商标。"
                                       Classes="caption"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>

                </Grid>
      </Grid>
    </Border>
</UserControl>
