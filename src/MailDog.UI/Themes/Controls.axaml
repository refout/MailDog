<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    组件规格（详见 docs/UI-TOKENS.md 第 4 节）
    规则：尺寸只取 MailDogSize* / MailDogRadius*，颜色只取 MailDogBrush*
    本文件按控件类型分组，一个类型一套规格。
  -->

  <!-- ================= 输入类 ================= -->

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MailDogPadControl}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
  </Style>

  <Style Selector="TextBox.multiline">
    <Setter Property="MinHeight" Value="240" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MailDogPadControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ================= 按钮 ================= -->

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MailDogPadButton}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeStrong}" />
  </Style>

  <!-- 主色按钮 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentBase}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextOnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MailDogBrushTextOnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentPressed}" />
  </Style>

  <!-- 轻量按钮：无底色、无边框 -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>

  <!-- 链接按钮：无底色、无边框，只保留文字链接外观 -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushAccentBase}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MailDogBrushAccentHover}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MailDogBrushAccentPressed}" />
  </Style>

  <!-- 危险操作 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushStatusDanger}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushStatusDangerTint}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MailDogBrushStatusDanger}" />
  </Style>

  <!-- 尺寸档位 -->
  <Style Selector="Button.sm">
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeightSm}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Button.lg">
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeightLg}" />
    <Setter Property="Padding" Value="16,0" />
  </Style>

  <!-- 图标按钮：正方形 -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{DynamicResource MailDogSizeControlHeightLg}" />
    <Setter Property="Height" Value="{DynamicResource MailDogSizeControlHeightLg}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon.sm">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Margin" Value="0,0,4,4" />
  </Style>
  <Style Selector="Button.icon.toolbar.active">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentTint}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>

  <!-- ================= 滚动条 ================= -->

  <!-- 关闭自动隐藏，让滚动条占位而不是压在内容上；滑块统一圆角。 -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="MinHeight" Value="10" />
    <!-- Fluent 的 Thumb 模板把 Border 的圆角绑定到 Thumb.CornerRadius。只改 Border
         会被 FluentScrollBarThumb 的控件主题压回去；直接改 Thumb 才能保证悬停、
         按下时也一直是圆角。 -->
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb /template/ Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="2" />
  </Style>

  <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- ================= 导航项与菜单项 ================= -->

  <Style Selector="Button.nav-item">
    <Setter Property="Height" Value="{DynamicResource MailDogSizeRowOneLine}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
  </Style>
  <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>
  <Style Selector="Button.nav-item.active">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav-item.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>

  <Style Selector="Button.menu-item">
    <Setter Property="Height" Value="{DynamicResource MailDogSizeRowOneLine}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
  </Style>
  <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>
  <Style Selector="Button.menu-item.active">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentTint}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 字段触发器（日期框这类“看起来像输入框的按钮”） -->
  <Style Selector="Button.field-trigger">
    <Setter Property="Height" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="{DynamicResource MailDogPadControl}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfaceSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeDefault}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.field-trigger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>

  <!-- 日历格 -->
  <Style Selector="Button.calendar-cell">
    <Setter Property="Width" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeCaption}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.calendar-cell:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>
  <Style Selector="Button.calendar-cell.outside">
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextTertiary}" />
  </Style>
  <Style Selector="Button.calendar-cell.today">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushAccentBase}" />
  </Style>
  <Style Selector="Button.calendar-cell.selected">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentBase}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextOnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.calendar-cell.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentHover}" />
  </Style>

  <!-- ================= 容器 ================= -->

  <!-- 主窗口三栏共用一套工作区表面：同一圆角、描边和裁剪边界。 -->
  <Style Selector="Border.workspace-column">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfacePane}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusSurface}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.workspace-column.navigation">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfaceSubtle}" />
  </Style>
  <Style Selector="Border.workspace-column.list">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfaceContent}" />
  </Style>
  <Style Selector="Border.workspace-column.reader">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfaceContent}" />
  </Style>

  <!-- 设置页分组卡片：所有页面只保留这一种层级，组内不再各自造边框和间距。 -->
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusSurface}" />
    <Setter Property="Padding" Value="{DynamicResource MailDogPadCard}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.settings-card TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeCardTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.settings-page-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.settings-nav-title">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>

  <Style Selector="Button.settings-footer">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeControlHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
  </Style>
  <Style Selector="Button.settings-footer:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>

  <!-- ================= 列表与浮层 ================= -->

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="Margin" Value="4,1" />
  </Style>

  <Style Selector="ListBox.mail-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.mail-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="ListBox.mail-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="ListBox.mail-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="ListBox.mail-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="ListBox.mail-list ListBoxItem:selected:focus">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>

  <Style Selector="ListBox.settings-nav ListBoxItem">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem.nav-group-gap">
    <Setter Property="Margin" Value="4,14,4,1" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected:focus">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>

  <Style Selector="TreeViewItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="TreeViewItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextPrimary}" />
  </Style>
  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="TreeViewItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>
  <Style Selector="TreeViewItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSelectionTint}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfacePopup}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusCard}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushSurfacePopup}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStrokeDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusCard}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="MinHeight" Value="{DynamicResource MailDogSizeRowOneLine}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
  </Style>

  <!-- ================= 文本样式 ================= -->

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextSecondary}" />
  </Style>

  <!-- 被禁用的设置分组保持文字与控件同样的弱化层级 -->
  <Style Selector="StackPanel:disabled TextBlock">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="TextBlock.calendar-weekday">
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextTertiary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <!-- ================= 迁移期别名（视图里还在用旧 class，第 5 步统一换掉） ================= -->

  <Style Selector="Button.jump-item">
    <Setter Property="Height" Value="{DynamicResource MailDogSizeRowOneLine}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeBody}" />
  </Style>
  <Style Selector="Button.jump-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>
  <Style Selector="Button.jump-item.active">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentTint}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.filter-tab">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource MailDogTypeCaption}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.filter-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>
  <Style Selector="Button.filter-tab.active">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource MailDogBrushAccentBase}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.account-add">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MailDogRadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.account-add:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MailDogBrushFillHover}" />
  </Style>

</Styles>
