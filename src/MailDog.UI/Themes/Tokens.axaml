<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MailDogBrushBgBase" Color="#F3F3F3" />
      <SolidColorBrush x:Key="MailDogBrushBgLayer" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MailDogBrushBgSubtle" Color="#FAFAFA" />
      <SolidColorBrush x:Key="MailDogBrushHover" Color="#0A000000" />
      <SolidColorBrush x:Key="MailDogBrushStroke" Color="#E0E0E0" />
      <SolidColorBrush x:Key="MailDogBrushStrokeSubtle" Color="#EBEBEB" />
      <SolidColorBrush x:Key="MailDogBrushTextPrimary" Color="#1B1B1B" />
      <SolidColorBrush x:Key="MailDogBrushTextSecondary" Color="#616161" />
      <SolidColorBrush x:Key="MailDogBrushTextTertiary" Color="#8A8A8A" />
      <SolidColorBrush x:Key="MailDogBrushTextDisabled" Color="#BDBDBD" />
      <SolidColorBrush x:Key="MailDogBrushAccent" Color="#0F6CBD" />
      <SolidColorBrush x:Key="MailDogBrushAccentHover" Color="#115EA3" />
      <SolidColorBrush x:Key="MailDogBrushAccentTint" Color="#EBF3FC" />
      <SolidColorBrush x:Key="MailDogBrushDanger" Color="#C42B1C" />
      <SolidColorBrush x:Key="MailDogBrushDangerTint" Color="#FDF3F4" />
      <SolidColorBrush x:Key="MailDogBrushSuccess" Color="#0F7B0F" />
      <SolidColorBrush x:Key="MailDogBrushWarning" Color="#9D5D00" />
      <SolidColorBrush x:Key="MailDogBrushWarningTint" Color="#FFF9F0" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="MailDogBrushBgBase" Color="#202020" />
      <SolidColorBrush x:Key="MailDogBrushBgLayer" Color="#272727" />
      <SolidColorBrush x:Key="MailDogBrushBgSubtle" Color="#1F1F1F" />
      <SolidColorBrush x:Key="MailDogBrushHover" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="MailDogBrushStroke" Color="#3D3D3D" />
      <SolidColorBrush x:Key="MailDogBrushStrokeSubtle" Color="#333333" />
      <SolidColorBrush x:Key="MailDogBrushTextPrimary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MailDogBrushTextSecondary" Color="#C7C7C7" />
      <SolidColorBrush x:Key="MailDogBrushTextTertiary" Color="#9A9A9A" />
      <SolidColorBrush x:Key="MailDogBrushTextDisabled" Color="#6E6E6E" />
      <SolidColorBrush x:Key="MailDogBrushAccent" Color="#479EF5" />
      <SolidColorBrush x:Key="MailDogBrushAccentHover" Color="#62ABF5" />
      <SolidColorBrush x:Key="MailDogBrushAccentTint" Color="#1A3A5C" />
      <SolidColorBrush x:Key="MailDogBrushDanger" Color="#FF99A4" />
      <SolidColorBrush x:Key="MailDogBrushDangerTint" Color="#3B1A1A" />
      <SolidColorBrush x:Key="MailDogBrushSuccess" Color="#6CCB5F" />
      <SolidColorBrush x:Key="MailDogBrushWarning" Color="#FCE100" />
      <SolidColorBrush x:Key="MailDogBrushWarningTint" Color="#3A3010" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
