<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MailDogBrushBgBase" Color="#F3F3F3" />
      <SolidColorBrush x:Key="MailDogBrushBgLayer" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MailDogBrushBgSubtle" Color="#FAFAFA" />
      <SolidColorBrush x:Key="MailDogBrushStroke" Color="#E0E0E0" />
      <SolidColorBrush x:Key="MailDogBrushTextPrimary" Color="#1B1B1B" />
      <SolidColorBrush x:Key="MailDogBrushTextSecondary" Color="#616161" />
      <SolidColorBrush x:Key="MailDogBrushAccent" Color="#0F6CBD" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="MailDogBrushBgBase" Color="#202020" />
      <SolidColorBrush x:Key="MailDogBrushBgLayer" Color="#272727" />
      <SolidColorBrush x:Key="MailDogBrushBgSubtle" Color="#1F1F1F" />
      <SolidColorBrush x:Key="MailDogBrushStroke" Color="#3D3D3D" />
      <SolidColorBrush x:Key="MailDogBrushTextPrimary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MailDogBrushTextSecondary" Color="#C7C7C7" />
      <SolidColorBrush x:Key="MailDogBrushAccent" Color="#479EF5" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
