<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    设计令牌（详见 docs/UI-TOKENS.md）
    分层：FluentTheme.Palettes → Color → Brush → Themes/Controls.axaml
    规则：视图里不写十六进制；尺寸/字号只取本文件的 MailDogSize* / MailDogType*
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="MailDogColorSurfaceWindow">#F3F3F3</Color>
      <Color x:Key="MailDogColorSurfacePane">#FFFFFF</Color>
      <Color x:Key="MailDogColorSurfaceSubtle">#FAFAFA</Color>
      <Color x:Key="MailDogColorSurfaceCard">#FFFFFF</Color>
      <Color x:Key="MailDogColorSurfacePopup">#FFFFFF</Color>
      <Color x:Key="MailDogColorSurfaceSolid">#FFFFFF</Color>
      <Color x:Key="MailDogColorAccentTint">#EBF3FC</Color>
      <Color x:Key="MailDogColorSelectionTint">#DCE9F7</Color>
      <Color x:Key="MailDogColorFillHover">#0A000000</Color>
      <Color x:Key="MailDogColorStatusDanger">#C42B1C</Color>
      <Color x:Key="MailDogColorStatusDangerTint">#FDF3F4</Color>
      <Color x:Key="MailDogColorStatusSuccess">#0F7B0F</Color>
      <Color x:Key="MailDogColorStatusWarning">#9D5D00</Color>
      <Color x:Key="MailDogColorStatusWarningTint">#FFF9F0</Color>
      <Color x:Key="MailDogColorTextOnAccent">#FFFFFF</Color>
      <Color x:Key="MailDogColorTextPrimary">#1B1B1B</Color>
      <Color x:Key="MailDogColorTextSecondary">#616161</Color>
      <Color x:Key="MailDogColorTextTertiary">#8A8A8A</Color>
      <Color x:Key="MailDogColorTextDisabled">#BDBDBD</Color>
      <Color x:Key="MailDogColorStrokeDefault">#E0E0E0</Color>
      <Color x:Key="MailDogColorStrokeSubtle">#EBEBEB</Color>
      <Color x:Key="MailDogColorStrokeStrong">#BDBDBD</Color>
      <Color x:Key="MailDogColorAccentBase">#0F6CBD</Color>
      <Color x:Key="MailDogColorAccentHover">#115EA3</Color>
      <Color x:Key="MailDogColorAccentPressed">#0B4F8A</Color>

      <!-- 覆盖 Fluent 默认高饱和选中蓝，列表与导航统一使用柔和 accent tint。 -->
      <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#EBF3FC" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#DCEBFA" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#CDE1F7" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#EBF3FC" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#DCEBFA" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#CDE1F7" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#1B1B1B" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#1B1B1B" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#1B1B1B" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="MailDogColorSurfaceWindow">#202020</Color>
      <Color x:Key="MailDogColorSurfacePane">#272727</Color>
      <Color x:Key="MailDogColorSurfaceSubtle">#1F1F1F</Color>
      <Color x:Key="MailDogColorSurfaceCard">#272727</Color>
      <Color x:Key="MailDogColorSurfacePopup">#272727</Color>
      <Color x:Key="MailDogColorSurfaceSolid">#2A2A2A</Color>
      <Color x:Key="MailDogColorAccentTint">#1A3A5C</Color>
      <Color x:Key="MailDogColorSelectionTint">#23476C</Color>
      <Color x:Key="MailDogColorFillHover">#0FFFFFFF</Color>
      <Color x:Key="MailDogColorStatusDanger">#FF99A4</Color>
      <Color x:Key="MailDogColorStatusDangerTint">#3B1A1A</Color>
      <Color x:Key="MailDogColorStatusSuccess">#6CCB5F</Color>
      <Color x:Key="MailDogColorStatusWarning">#FCE100</Color>
      <Color x:Key="MailDogColorStatusWarningTint">#3A3010</Color>
      <Color x:Key="MailDogColorTextOnAccent">#0A0A0A</Color>
      <Color x:Key="MailDogColorTextPrimary">#FFFFFF</Color>
      <Color x:Key="MailDogColorTextSecondary">#BDBDBD</Color>
      <Color x:Key="MailDogColorTextTertiary">#8A8A8A</Color>
      <Color x:Key="MailDogColorTextDisabled">#5C5C5C</Color>
      <Color x:Key="MailDogColorStrokeDefault">#3D3D3D</Color>
      <Color x:Key="MailDogColorStrokeSubtle">#2B2B2B</Color>
      <Color x:Key="MailDogColorStrokeStrong">#5C5C5C</Color>
      <Color x:Key="MailDogColorAccentBase">#479EF5</Color>
      <Color x:Key="MailDogColorAccentHover">#62ABF5</Color>
      <Color x:Key="MailDogColorAccentPressed">#3D8BF8</Color>

      <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#1A3A5C" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#21466B" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#28537C" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#1A3A5C" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#21466B" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#28537C" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#FFFFFF" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ========== 语义画刷（新名，视图迁移目标） ========== -->
  <SolidColorBrush x:Key="MailDogBrushSurfaceWindow" Color="{DynamicResource MailDogColorSurfaceWindow}" />
  <SolidColorBrush x:Key="MailDogBrushSurfacePane" Color="{DynamicResource MailDogColorSurfacePane}" />
  <!-- 承字面：列表与阅读区。它比 Pane 更实，避免桌面内容透过文字（见 MainWindow.ApplyPalette）。 -->
  <SolidColorBrush x:Key="MailDogBrushSurfaceContent" Color="{DynamicResource MailDogColorSurfacePane}" />
  <SolidColorBrush x:Key="MailDogBrushSurfaceSubtle" Color="{DynamicResource MailDogColorSurfaceSubtle}" />
  <SolidColorBrush x:Key="MailDogBrushSurfaceCard" Color="{DynamicResource MailDogColorSurfaceCard}" />
  <SolidColorBrush x:Key="MailDogBrushSurfacePopup" Color="{DynamicResource MailDogColorSurfacePopup}" />
  <SolidColorBrush x:Key="MailDogBrushSurfaceSolid" Color="{DynamicResource MailDogColorSurfaceSolid}" />
  <SolidColorBrush x:Key="MailDogBrushFillHover" Color="{DynamicResource MailDogColorFillHover}" />

  <SolidColorBrush x:Key="MailDogBrushTextPrimary" Color="{DynamicResource MailDogColorTextPrimary}" />
  <SolidColorBrush x:Key="MailDogBrushTextSecondary" Color="{DynamicResource MailDogColorTextSecondary}" />
  <SolidColorBrush x:Key="MailDogBrushTextTertiary" Color="{DynamicResource MailDogColorTextTertiary}" />
  <SolidColorBrush x:Key="MailDogBrushTextDisabled" Color="{DynamicResource MailDogColorTextDisabled}" />
  <SolidColorBrush x:Key="MailDogBrushTextOnAccent" Color="{DynamicResource MailDogColorTextOnAccent}" />

  <SolidColorBrush x:Key="MailDogBrushStrokeDefault" Color="{DynamicResource MailDogColorStrokeDefault}" />
  <SolidColorBrush x:Key="MailDogBrushStrokeSubtle" Color="{DynamicResource MailDogColorStrokeSubtle}" />
  <SolidColorBrush x:Key="MailDogBrushStrokeStrong" Color="{DynamicResource MailDogColorStrokeStrong}" />

  <SolidColorBrush x:Key="MailDogBrushAccentBase" Color="{DynamicResource MailDogColorAccentBase}" />
  <SolidColorBrush x:Key="MailDogBrushAccentHover" Color="{DynamicResource MailDogColorAccentHover}" />
  <SolidColorBrush x:Key="MailDogBrushAccentPressed" Color="{DynamicResource MailDogColorAccentPressed}" />
  <SolidColorBrush x:Key="MailDogBrushAccentTint" Color="{DynamicResource MailDogColorAccentTint}" />
  <SolidColorBrush x:Key="MailDogBrushSelectionTint" Color="{DynamicResource MailDogColorSelectionTint}" />

  <SolidColorBrush x:Key="MailDogBrushStatusDanger" Color="{DynamicResource MailDogColorStatusDanger}" />
  <SolidColorBrush x:Key="MailDogBrushStatusDangerTint" Color="{DynamicResource MailDogColorStatusDangerTint}" />
  <SolidColorBrush x:Key="MailDogBrushStatusSuccess" Color="{DynamicResource MailDogColorStatusSuccess}" />
  <SolidColorBrush x:Key="MailDogBrushStatusWarning" Color="{DynamicResource MailDogColorStatusWarning}" />
  <SolidColorBrush x:Key="MailDogBrushStatusWarningTint" Color="{DynamicResource MailDogColorStatusWarningTint}" />

  <!-- ========== 尺寸（紧凑档为默认值；标准档由 ThemeService 运行时覆盖） ========== -->
  <x:Double x:Key="MailDogSizeControlHeight">28</x:Double>
  <x:Double x:Key="MailDogSizeControlHeightSm">24</x:Double>
  <x:Double x:Key="MailDogSizeControlHeightLg">32</x:Double>
  <x:Double x:Key="MailDogSizeRowOneLine">32</x:Double>
  <x:Double x:Key="MailDogSizeRowTwoLine">56</x:Double>
  <x:Double x:Key="MailDogSizeMailRow">64</x:Double>
  <x:Double x:Key="MailDogSizeCommandBar">40</x:Double>
  <x:Double x:Key="MailDogSizePagePadding">16</x:Double>
  <x:Double x:Key="MailDogSizeSectionGap">12</x:Double>
  <x:Double x:Key="MailDogSizeColumnGap">8</x:Double>
  <x:Double x:Key="MailDogSizeSettingsNav">232</x:Double>
  <x:Double x:Key="MailDogSizeIcon">16</x:Double>
  <x:Double x:Key="MailDogSizeIconLg">20</x:Double>

  <CornerRadius x:Key="MailDogRadiusControl">4</CornerRadius>
  <CornerRadius x:Key="MailDogRadiusCard">6</CornerRadius>
  <CornerRadius x:Key="MailDogRadiusPanel">6</CornerRadius>
  <CornerRadius x:Key="MailDogRadiusSurface">8</CornerRadius>
  <CornerRadius x:Key="MailDogRadiusPill">999</CornerRadius>
  <Thickness x:Key="MailDogPadControl">10,0</Thickness>
  <Thickness x:Key="MailDogPadButton">12,0</Thickness>
  <Thickness x:Key="MailDogPadPage">16</Thickness>
  <Thickness x:Key="MailDogPadCard">18</Thickness>

  <!-- ========== 字号 ========== -->
  <x:Double x:Key="MailDogTypeDisplay">28</x:Double>
  <x:Double x:Key="MailDogTypeTitle">20</x:Double>
  <x:Double x:Key="MailDogTypeCardTitle">14</x:Double>
  <x:Double x:Key="MailDogTypeBody">13</x:Double>
  <x:Double x:Key="MailDogTypeCaption">12</x:Double>
</ResourceDictionary>
