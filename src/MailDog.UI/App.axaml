<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MailDog.UI.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <!-- 客户区延展后的标题条不能带底色，否则会盖住 Mica/Acrylic。 -->
      <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent" />
      <x:Double x:Key="CaptionButtonWidth">46</x:Double>
      <x:Double x:Key="CaptionButtonHeight">32</x:Double>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MailDog.UI/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0F6CBD" />
        <ColorPaletteResources x:Key="Dark" Accent="#479EF5" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://MailDog.UI/Themes/Controls.axaml" />
    <!-- 标题文字和品牌由 MainWindow 自绘；这里隐藏默认 overlay 文字与全屏按钮。 -->
    <Style Selector="chrome|WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel TextBlock">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="chrome|WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>

