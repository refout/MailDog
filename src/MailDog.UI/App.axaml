<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MailDog.UI.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MailDog.UI/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0F6CBD" />
        <ColorPaletteResources x:Key="Dark" Accent="#479EF5" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.single-line">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextTertiary}" />
    </Style>
    <Style Selector="ListBox.mail-list">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.account-add">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.account-add:pointerover">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushHover}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="4,1" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushPopup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.calendar-weekday">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextTertiary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.calendar-day">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.calendar-day:pointerover">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushHover}" />
    </Style>
    <Style Selector="Button.calendar-day.outside">
      <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextTertiary}" />
    </Style>
    <Style Selector="Button.calendar-day.today">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushAccent}" />
    </Style>
    <Style Selector="Button.calendar-day.selected">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource MailDogBrushTextOnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.calendar-day.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentHover}" />
    </Style>
    <Style Selector="Button.jump-item">
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.jump-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushHover}" />
    </Style>
    <Style Selector="Button.jump-item.active">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentTint}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.date-field">
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource MailDogBrushBgSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MailDogBrushStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.date-field:pointerover">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushHover}" />
    </Style>
    <!-- 左侧栏：统一文件夹与账户树 -->
    <Style Selector="Button.side-item">
      <Setter Property="Height" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.side-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushHover}" />
    </Style>
    <Style Selector="Button.side-item.active">
      <Setter Property="Background" Value="{DynamicResource MailDogBrushAccentTint}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
